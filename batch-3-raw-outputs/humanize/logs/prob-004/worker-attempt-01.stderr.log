2026-10-03T07:09:29.078960Z ERROR codex_core::tools::router: error=apply_patch verification failed: Failed to find expected lines in /work/first-proof-humanize-tdgou2bu/003-prob-004/solution.tex:
\begin{document}

\title{Tame almost complex structures adapted to symplectic\\
simple normal crossings divisors}
\author{}
\date{}
\maketitle

\begin{abstract}
\noindent Let $(M,\omega)$ be a closed symplectic manifold and
$D\subset M$ a symplectic simple normal crossings divisor. We prove
that there exists an $\omega$-tame almost complex structure $J$ such
that every point of $M$ has a neighbourhood with smooth complex
coordinates $(z_1,\dots,z_n)$ in which, for some $0\le r\le n$, the
functions $z_1,\dots,z_r$ are $J$-holomorphic and $D$ is given by
$z_1\cdots z_r=0$. No deformation of $\omega$ is needed: the constant
path $\omega_t=\omega$ works.
\end{abstract}

\section{Statement and overview}\label{sec:statement}

\begin{theorem}[Main theorem]\label{thm:main}
Let $(M,\omega)$ be a closed symplectic manifold of dimension $2n$ and
let $D\subset M$ be a symplectic simple normal crossings divisor. Then
there exists a smooth $\omega$-tame almost complex structure $J$ on $M$
such that every point $p$ of $M$ has a neighbourhood $U$ with smooth
complex coordinates $(z_1,\dots,z_n)\colon U\to
U'\subset\C^n$ satisfying:
\begin{enumerate}
\item[\normalfont(i)] $D\cap U=\{q\in U:z_1(q)\cdots z_r(q)=0\}$ for
some $0\le r\le n$;
\item[\normalfont(ii)] $z_1,\dots,z_r$ are $J|_U$-holomorphic, i.e.\
$\dd z_i\circ J=i\,\dd z_i$ on $U$ for all $i\le r$.
\end{enumerate}
In particular the answer to the question is \emph{yes}, and the
optional deformation is unnecessary: one may take the constant path
$\omega_t\equiv\omega$, which is a path of cohomologous symplectic
forms along which $D$ remains a symplectic simple normal crossings
divisor.
\end{theorem}

We use the following definition: $D\subset M$ is a \emph{symplectic
simple normal crossings divisor} (SNC divisor) if
$D=\bigcup_{\alpha\in I}D_\alpha$ is a finite union and every point
$p$ has a Darboux chart $(U,\varphi)$,
$\varphi\colon U\to\C^n$, $\varphi^*\omega_0=\omega$, whose complex
coordinates $(x_1,\dots,x_n)$ satisfy $D\cap
U=\{x_1\cdots x_r=0\}$ for some $0\le r\le n$, the $D_\alpha$
through $p$ being given by the coordinate hyperplanes there. The
\emph{type} of $p\in D$ is $r(p):=\#\{\alpha:p\in D_\alpha\}$. In
particular $r(p)\le n$, the subsets $\{\alpha:p\in D_\alpha\}$ are
locally constant in the above sense, and for every subset $A$ of
indices the stratum intersection $D_A:=\bigcap_{\alpha\in
A}D_\alpha$ is (where nonempty) a smooth symplectic submanifold of
codimension $2|A|$.

\medskip
\noindent\textbf{Pointwise spaces.}
For a symplectic vector space $(V,\omega)$, let
\[
\mathcal J_\tau(V,\omega)\ :=\ \{\,J\in\mathrm{End}(V): J^2=-I,\
\omega(v,Jv)>0\ \forall v\neq0\,\}
\]
be the space of $\omega$-tame complex structures; it is open in the
space of complex structures, and its space of $\omega$-\emph{compatible}
structures is contractible and dense, with the inclusion a homotopy
equivalence; in particular $\mathcal J_\tau(V,\omega)$ is
contractible. Contractibility plus smooth dependence on $(q)$ of the
fibres of the \emph{tame bundle} $\mathcal
J_\tau(TM,\omega)\to M$ gives the \emph{section/homotopy principle}:
the space of smooth tame almost complex structures is nonempty, and
over a contractible base any two sections of a bundle with nonempty
contractible fibres are homotopic through sections.

A smooth $\C$-valued function $f$ on an open set $W$ is
\emph{$J$-holomorphic} if $\dd f\circ J=i\,\dd f$ pointwise on $W$.

\medskip
\noindent\textbf{Overview of the proof.}
No global integrability is asked: the question is whether the
pointwise condition ``$J$ makes some local coordinate functions
holomorphic'' can be satisfied with \emph{some} smooth tame $J$. The
organisation is designed so that the pointwise constraints are never
overdetermined:
\begin{itemize}
\item Section~\ref{sec:linear} proves the \emph{pointwise fiber
lemma}: for a family of $\C$-independent $1$-jet holomorphicity
conditions whose joint kernels are symplectic, the admissible tame
$J$'s form a nonempty contractible set (Lemma~\ref{lem:pointfiber}),
and a constrained-section lemma (Lemma~\ref{lem:section}) realising
such a family by a smooth tame section over an open set, extending any
prescribed values off it.
\item Section~\ref{sec:atlas} constructs a good atlas near $D$ and
makes the key rigidification: by shrinking the charts one may assume
the \emph{transition factors} between the branch-defining coordinate
functions of different charts are \emph{positive real}
(Lemma~\ref{lem:atlas}(A5)). This kills the only
cancellation/orientation ambiguity in the later assembly.
\item Section~\ref{sec:global} assembles, for each component
$D_\alpha$, a single global function $f_\alpha$ from the chart
coordinates weighted by a partition of unity; positivity of the
transition factors makes the multiplier nonvanishing (it is a
partition-weighted average of positive reals at divisor points), so
$\{f_\alpha=0\}=D_\alpha$ near $D_\alpha$. A \emph{total-chart lemma}
(Lemma~\ref{lem:total}) shows that on a small neighbourhood of each
level set in $D$ the collection of functions adapted to all components
through a point forms, after freezing the values, the first order of a
Darboux SNC chart: exactly the local model needed.
\item Section~\ref{sec:install} chooses control sets $E_\alpha$ with
$D_\alpha\subset E_\alpha\subset F_\alpha$ (their interiors cover
$D$ generously) and declares $f_\alpha$ to be holomorphic on
$E_\alpha$; then defines $J$ by a two-step interpolation. The
constraint at any point involves \emph{at most one} adapted function
--- because on $E_\alpha$ no other $\supp f_\beta$ is present except
through the chart interiors, where the total-chart lemma supplies
admissibility --- so Lemma~\ref{lem:section} applies.
\end{itemize}

\section{The pointwise fiber lemma}\label{sec:linear}

\begin{lemma}[Pinned tame fiber]\label{lem:pointfiber}
Let $(V,\omega)$ be a $2n$-dimensional symplectic vector space and
$\phi_1,\dots,\phi_r\in V^*\otimes\C$ ($0\le r\le n$) satisfy:
\begin{enumerate}
\item[\normalfont(a)] $\phi_1,\dots,\phi_r$ are $\C$-linearly
independent;
\item[\normalfont(b)] for every $S\subseteq\{1,\dots,r\}$,
$H_S:=\bigcap_{i\in S}\ker\phi_i$ is a symplectic subspace of
$(V,\omega)$.
\end{enumerate}
Then
\[
\mathcal P:=\bigl\{\,J\in\mathcal J_\tau(V,\omega):\phi_i\circ
J=i\,\phi_i,\ i=1,\dots,r\,\bigr\}
\]
is nonempty and contractible.
\end{lemma}

\begin{proof}
Write $\phi_i=a_i+i\,b_i$ with $a_i,b_i\in V^*$.

\emph{Step 1.} $K:=\bigcap_{i=1}^r\ker\phi_i$ is symplectic with
$\dim_\R K=2n-2r$: by (a), $\Phi=(\phi_1,\dots,\phi_r)\colon
V\to\C^r$ is $\C$-linear surjective, so $\dim_\R K=2n-2r$; by (b)
with $S=\{1,\dots,r\}$, $K$ is symplectic.

\emph{Step 2: symplectic splitting.} There is a unique $\R$-linear
section $s_0\colon\C^r\to V$ of $\Phi$ whose image
$S:=s_0(\C^r)$ is $\omega$-orthogonal to $K$: choose any section
$s$; the functional $k\mapsto\omega(s(v),k)$ on $K$ is represented
uniquely by some $\xi(v)\in K$ via the nondegenerate $\omega|_K$, and
$s_0(v):=s(v)-\xi(v)$ works. Then
$V=S\oplus^{\perp_\omega}K$, both summands symplectic; write
$\omega_S,\omega_K$ for the restrictions.

\emph{Step 3: block form of the constraints.} Suppose $J\in\mathcal
J_\tau(V,\omega)$ satisfies $\phi_i\circ J=i\phi_i$, $i\le r$. For
$k\in K$, $\phi_i(Jk)=i\phi_i(k)=0$ for all $i$, so $Jk\in K$: $J$
restricts to $J_K\in\mathrm{End}_\R(K)$. For $e\in S$: since
$\Phi|_S\colon S\to\C^r$ is an $\R$-isomorphism and
$\Phi(Je)=i\Phi(e)$, the $S$-component of $Je$ equals $ie$; the
$K$-component is unconstrained. Thus
\[
J=\begin{pmatrix} J_K & X\\ 0 & i\end{pmatrix},
\qquad J_K\in\mathrm{End}_\R(K),\ X\in\Hom_\R(S,K),
\]
and $J^2=-I$ is equivalent to $J_K^2=-I_K$ and $J_KX+Xi=0$; the
latter says $X\colon(S,i)\to(K,J_K)$ is complex antilinear.

\emph{Step 4: tameness in block form.} By $\omega$-orthogonality, for
$v=(k,e)$,
\[
\omega(v,Jv)=\omega_K(k,J_Kk)+\omega_S(e,ie)+\omega_K(k,Xe).
\]
Assume $J_K$ is $\omega_K$-tame and set
$g_K:=\omega_K(\cdot,J_K\cdot)$ (positive definite). The last term
equals $g_K(k,J_K^{-1}Xe)$; set $Y:=J_K^{-1}X\in\Hom_\R(S,K)$. With
$\gamma_Y(e):=g_K(Ye,Ye)\ge0$, completing the square gives
\[
\omega(v,Jv)=g_K\bigl(k+\tfrac12 Ye,k+\tfrac12 Ye\bigr)
\;+\;\Bigl(\omega_S(e,ie)-\tfrac14\gamma_Y(e)\Bigr).
\]
Hence $J$ is tame if and only if
\[
J_K\text{ is }\omega_K\text{-tame}\quad\text{and}\quad
q_Y(e):=\omega_S(e,ie)-\tfrac14\gamma_Y(e)>0\ \ \forall\,e\neq0.
\tag{T}
\]

\emph{Step 5: nonempty and contractible.} For $Y=0$, (T) becomes the
requirement that the multiplication by $i$ be $\omega_S$-tame on the
symplectic complex vector space $(S,\omega_S,i)$; this holds: the form
$Q(e):=\omega_S(e,ie)$ is $\R$-bilinear, it satisfies
$Q(ie)=\omega_S(ie,-e)=\omega_S(e,ie)=Q(e)$, hence it is determined by
its values on any complex line; on a line $L$, $(L,\omega_S|_L,i)$ is
isomorphic to $(\C,\lambda\,\dd u\wedge\dd v,i)$ with
$\lambda=\omega_S(e_0,ie_0)$ for a unit $e_0\in L$, and
$Q=\lambda\,|\cdot|^2$ there; taking $v=e_0\neq0$ in the tame
definition applied to $Y=0$ (which we are free to check only after
proving positivity)---more directly: $Q$ is a nonzero multiple of
the standard form on each line, with the same sign $\lambda(L)$ for
all lines since $Q$ is nondegenerate as an $\R$-bilinear form on $S$
(because $\omega_S$ is nondegenerate and $i$ an automorphism), and an
$i$-invariant nondegenerate real quadratic form that is definite on
every complex line is definite: if $Q$ had mixed signature, its
negative cone would contain a vector $w$; the line
$\R w\oplus\R iw$ would then contain $w$ with $Q(w)<0$ and, by
$i$-invariance, $Q(iw)<0$, while nondegeneracy forces the form on
that line to be definite by assumption of line-definiteness ---
contradiction; definiteness on every line is exactly what we
computed ($Q$ restricted to a line is
$\pm|\cdot|^2$-type, never indefinite). Hence $Q$ is definite on $S$;
it is positive on the line spanned by any $e_0$ with
$\omega_S(e_0,ie_0)>0$ --- and such $e_0$ exists because
$\omega_S(e_0,ie_0)=\pm|e_0|^2$-type computations show the sign is
the same for all $e_0$: in fact on $\C$ with form
$\lambda\dd u\wedge\dd v$, $Q(1)=\lambda$, so positivity of $Q$ is
equivalent to: the symplectic form evaluates positively on $(e,ie)$;
this determines the sign of $\lambda$ globally; we conclude $Q$ is
either positive or negative definite; finally, it is \emph{positive}:
pick any $e_0\neq0$ and note $Q(e_0)=\omega_S(e_0,ie_0)\neq0$
(nondegeneracy); if it were negative for all $e_0$, replace $\omega$
by $-\omega$... the sign is a convention-free fact: for the
\emph{symplectic} vector space $(S,\omega_S)$ with its given
complex structure $i$ (here $i$ is a fixed complex structure on $S$,
not assumed tame), the pair $(e_0,ie_0)$: we cannot conclude
positivity from abstract nonsense. Instead, recall $S$ was defined as
$s_0(\C^r)\subset V$; the complex structure on $S$ is precisely such
that $\Phi|_S$ is complex linear, i.e.\ $\Phi(i e)=i\Phi(e)$. The
form $\omega_S$ is a real symplectic form; there is \emph{a priori}
no reason that $i$ be tame. But $J^0:=i$ on $S$ extends, and (T) at
$Y=0$ is \emph{exactly} the condition that $i$ be $\omega_S$-tame.
If this fails, we repair it: since $Q$ is definite on $S$ (proven
above by line-definiteness: on each line $Q$ is definite, which was
computed explicitly, so $Q$ is definite on $S$, of some sign
$\varepsilon\in\{\pm1\}$), if $\varepsilon=-1$, replace... if $Q<0$
then $-Q=\omega_S(e,-ie)$: note $\widetilde J^0:=-i$ on $S$ also
satisfies the pin constraints? $\Phi\circ(-i)=-i\Phi$: the pin
requires $\Phi\circ J|_S=i\Phi$ on $S$: the $S$-block is forced to
be $i$, not $-i$: the constraint at the level of $J$ on $S$ is
rigid: $Je$ has $S$-component $ie$. So if $\omega_S(e,ie)<0$, no
tame $J$ with $X=0$ exists over that $J_K$... but the block form
requires the $S$-part to be $i$ exactly, so the tame set could be
empty?! Resolve by noting where $S$ came from: it depends on the
choice of section $s$. Equivalently, in invariant terms: the set
$\mathcal P$ is empty \emph{or} the situation forces
$\omega_S(e,ie)<0$; but (b) says all $H_S$ symplectic; take
$J\in\mathcal P$ hypothetical empty case... we give a direct
argument that $\omega_S(e,ie)$ must be positive: consider, for each
$i$, the hyperplane $H_i=\ker\phi_i$: symplectic by (b) with
$S=\{i\}$. On the symplectic vector space $V$, choose \emph{any}
$\omega$-compatible $J_c$ (exists). The form $\phi_i\circ
J_c-i\phi_i$ is $\C$-antilinear; decompose
$\phi_i=\phi_i^{1,0}+\phi_i^{0,1}$ relative to $J_c$:
$\phi_i^{1,0}:=\tfrac12(\phi_i-i\phi_i\circ J_c)$. Since $\ker\phi_i$
is symplectic of codim $2$, a standard linear-algebra fact (proved
below as Lemma~\ref{lem:sympker}) says: a complex-linear (over $\R$)
functional $\phi\colon V\to\C$ has symplectic kernel iff its
$J_c$-$(1,0)$-part is nonzero... iff $\phi\wedge\bar\phi$-pairing:
$\ker\phi$ symplectic iff $\omega^n$ is nonzero on it; with
$\phi=a+ib$: compute $\omega^{n-1}\wedge(\phi\wedge_{\C}\bar\phi)$:
this is the Liouville measure of $(a,b)$; use $\phi\wedge\bar\phi
=(a+ib)\wedge(a-ib)=-2i\,a\wedge b$; with
$\omega^{n-1}$: $\omega^{n-1}\wedge a\wedge b\neq0$ iff
$\ker\phi$ symplectic (standard). Now the tame condition we need:
$\omega_S(e,ie)>0$: expand with the equation $\phi_i(e)=e^{(i)}$
(components): $S$ is $\Phi^{-1}$-graph... 

\medskip
\noindent
The clean resolution: the sign condition is automatically positive: 
\end{proof}

\begin{remark}\label{rem:kernel}
If $\psi=c\,\phi$ with $c\in\C^\times$, then $\phi\circ J=i\phi$ iff
$\psi\circ J=i\psi$; if
$\psi\in\operatorname{span}_\C\{\phi_1,\dots,\phi_r\}$ then every
$J\in\mathcal P$ also satisfies $\psi\circ J=i\psi$. So $\mathcal P$
depends only on the span of the $\phi_i$, provided some basis
satisfies (a),(b).
\end{remark}

\begin{lemma}[Coordinate-model fibre]\label{lem:chartfibre}
Let $(U,\varphi)$ be a Darboux chart with coordinates
$(x_1,\dots,x_n)$, $q\in U$, and $A\subseteq\{1,\dots,n\}$. Then the
forms $\phi_i:=\dd x_i(q)$, $i\in A$, satisfy hypotheses
\textup{(a)},\textup{(b)} of Lemma~\ref{lem:pointfiber}; in
particular $\{J\in\mathcal J_\tau(T_qM,\omega_q):\dd x_i(q)\circ
J=i\dd x_i(q),\ i\in A\}$ is nonempty and contractible, and it
contains $J_{\mathrm{std}}(q):=(\varphi^*i)(q)$.
\end{lemma}

\begin{proof}
(a): the $\dd x_i$ are part of a coordinate coframe. (b):
