   213	\section{The maximum principle}\label{sec:max}
   214	
   215	\begin{lemma}\label{lem:max}
   216	Let $(X,J)$ be a connected almost complex manifold of dimension
   217	$2m\ge2$, and $h\colon X\to\CC$ $J$-holomorphic. If $|h|$ has a
   218	local maximum at some point of $X$, then $h$ is constant. In
   219	particular, on a compact connected almost complex manifold every
   220	$J$-holomorphic function is constant.
   221	\end{lemma}
   222	
   223	\begin{proof}
   224	We use the local existence of $J$-holomorphic discs in almost
   225	complex manifolds (Nijenhuis--Woolf): for every $p\in X$ and every
   226	complex line $\ell\subset(T_pX,J_p)$ there is a $J$-holomorphic disc
   227	$\varphi\colon\Delta\to X$ with $\varphi(0)=p$ and
   228	$\varphi_{*}T_0\Delta=\ell$; moreover one can choose such discs
   229	smoothly depending on parameters (e.g.\ on the line and on nearby
   230	points), so that their images through $\{p'\}\times\{$lines in
   231	$T_{p'}X\}$ cover a neighbourhood of $p$.
   232	
   233	Suppose $|h|$ attains a local maximum at $p$. For any small
   234	$J$-holomorphic disc $\varphi\colon\Delta\to X$ with
   235	$\varphi(0)=p$, the composition $h\circ\varphi$ is holomorphic
   236	$\Delta\to\CC$ (chain rule from $\dd h\circ J=i\dd h$), and
   237	$|h\circ\varphi|$ attains a maximum at $0$; by the classical
   238	maximum modulus principle $h\circ\varphi$ is constant, in
   239	particular $h|_{\varphi(\Delta)}\equiv h(p)$. Since such discs
   240	through $p$ sweep a neighbourhood of $p$ (choose the disc family as
   241	above), $h\equiv h(p)$ on an open set containing $p$. Thus
   242	$\{q:h(q)=h(p)\}$ is open; it is also closed, and $X$ is
   243	connected, so $h\equiv h(p)$. The compact case follows because
   244	$|h|$ attains its maximum.
   245	\end{proof}
   246	
   247	\section{Proof of the obstruction}\label{sec:proof}
   248	
   249	\begin{proof}[Proof of Theorem~\ref{thm:obstruction}]
   250	Let $D_\alpha$ be a compact connected component; all components are
   251	smooth codimension-$2$ symplectic submanifolds, and we use the
   252	conormal complex line bundle $\nu_\alpha^*$ of
   253	Corollary~\ref{cor:normal}.
   254	
   255	\emph{Step 1: $J$-holomorphic conormal frames.}
   256	By SNC-adaptedness, cover $D_\alpha$ by finitely many adapted
   257	coordinate neighbourhoods $W_i$, with adapted coordinates
   258	$(z_1^{(i)},\dots,z_n^{(i)})$ in which $z_1^{(i)}$ is
   259	$J$-holomorphic and $\{z_1^{(i)}=0\}=D_\alpha\cap W_i$: indeed, at
   260	any $p\in D_\alpha$, among the components through $p$ one is
   261	$D_\alpha$, and renumbering the adapted coordinates puts it first
   262	(if $p\notin D_\alpha\setminus\bigcup_{\beta\neq\alpha}D_\beta$
   263	there is nothing to check near $p$ for the frames below: points of
   264	$D_\alpha$ on other components are fine: adapted coordinates exist
   265	there too, with $D_\alpha$ as one of the coordinate hyperplanes).
   266	On $W_i\cap D_\alpha$, set
   267	\[
   268	e_i\ :=\ \dd z_1^{(i)}\big|_{D_\alpha\cap W_i}
   269	\ \in\ \Gamma\bigl(D_\alpha\cap W_i,\ T^*M\otimes\CC\bigr).
   270	\]
   271	Since $z_1^{(i)}|_{D_\alpha\cap W_i}=0$, $e_i$ annihilates
   272	$T(D_\alpha)$, so it descends to a homomorphism
   273	$\nu_\alpha\to\CC$; since $\dd z_1^{(i)}\neq0$ along $D_\alpha$
   274	(it is a coordinate differential), $e_i\neq0$ everywhere on
   275	$D_\alpha\cap W_i$; and by $J$-holomorphicity,
   276	$e_i(Jv)=\dd z_1^{(i)}(Jv)=i\,\dd z_1^{(i)}(v)=i\,e_i(v)$, so $e_i$
   277	is $\CC$-linear for the complex structure of
   278	Corollary~\ref{cor:normal}: $e_i$ is a nowhere vanishing local frame
   279	of the complex line bundle $\nu_\alpha^*$.
   280	
   281	\emph{Step 2: constant transition functions.}
   282	On $W_i\cap W_j$, both $z_1^{(i)}$ and $z_1^{(j)}$ are
   283	$J$-holomorphic defining functions of
   284	$D_\alpha\cap W_i\cap W_j$, with the hypotheses of
   285	Lemma~\ref{lem:ratio}. Hence the ratio
   286	$h_{ij}:=z_1^{(j)}/z_1^{(i)}$ extends smoothly and nonvanishingly
   287	across $D_\alpha$, is $J$-holomorphic on $W_i\cap W_j$, and
   288	$e_j=h_{ij}\,e_i$ on $D_\alpha\cap W_i\cap W_j$ (this is
   289	\eqref{eq:cross}). Restricting to $D_\alpha$: by
   290	Lemma~\ref{lem:strata}, $J_\alpha:=J|_{TD_\alpha}$ is an almost
   291	complex structure on the compact connected manifold $D_\alpha$, and
   292	$h_{ij}|_{D_\alpha}$ is $J_\alpha$-holomorphic: indeed
   293	$\dd(h_{ij}|_{D_\alpha})\circ J_\alpha=(\dd h_{ij}\circ J)|_{TD_\alpha}
   294	=i\,\dd h_{ij}|_{TD_\alpha}=i\,\dd(h_{ij}|_{D_\alpha})$. By
   295	Lemma~\ref{lem:max}, $h_{ij}|_{D_\alpha}$ is constant on every
   296	connected component of $D_\alpha\cap W_i\cap W_j$.
   297	
   298	\emph{Step 3: flatness and vanishing Euler class.}
   299	The complex line bundle $\nu_\alpha^*$ thus admits a trivialising
   300	cover (the $e_i$) whose transition functions
   301	$\{h_{ij}|_{D_\alpha}\}$ are constant on each connected overlap
   302	piece. Choose on each $W_i\cap D_\alpha$ the connection whose
   303	covariant derivative kills $e_i$; since on overlaps the frames
   304	differ by constants, these local connections agree on overlaps and
   305	assemble to a global connection $\nabla$ on $\nu_\alpha^*$ with
   306	$\nabla e_i=0$ on $W_i$; its curvature satisfies
   307	$\Omega(e_i)=0$ locally, hence $\Omega\equiv0$: $\nabla$ is flat.
   308	By Chern--Weil theory (the first Chern form of a flat
   309	connection is identically zero),
   310	\[
   311	c_1(\nu_\alpha^*)\ =\ 0\ \in\ H^2(D_\alpha;\RR).
   312	\]
   313	For a complex line bundle, the Euler class of the oriented real
   314	plane bundle equals $c_1$, and duals reverse the sign; hence
   315	\[
   316	e(\nu_\alpha)\ =\ c_1(\nu_\alpha)\ =\ -c_1(\nu_\alpha^*)\ =\ 0 ,
   317	\qquad
   318	\langle e(\nu_\alpha),[D_\alpha]\rangle=0 .
   319	\]
   320	The self-intersection $D_\alpha\cdot D_\alpha:=\langle
   321	e(\nu_\alpha),[D_\alpha]\rangle$ therefore vanishes.
   322	\end{proof}
   323	
   324	\begin{proof}[Proof of Corollary~\ref{cor:cp2}]
   325	$(\CP^2,\omega_{\mathrm{FS}})$ is a closed symplectic manifold and
   326	a projective line $L$ is a smooth symplectic hypersurface; SNC for a
   327	single component is automatic. Its normal bundle is
   328	$\mathcal O(1)$ with $c_1$ evaluating to $1$ on $[L]$; so the
   329	conclusion of Theorem~\ref{thm:obstruction} fails: no
   330	$\omega_{\mathrm{FS}}$-tame SNC-adapted $J$ exists.
   331	
   332	For the deformation clause: suppose $\{\omega_t\}_{t\in[0,1]}$ is a
   333	path of cohomologous symplectic forms with $\omega_0=
   334	\omega_{\mathrm{FS}}$, along which $L$ remains a symplectic SNC
   335	divisor. Apply Theorem~\ref{thm:obstruction} to
   336	$(\CP^2,\omega_1,L)$: the hypothesis "$J$ is $\omega_1$-tame and
   337	SNC-adapted" implies $L\cdot L=0$; but $L\cdot L$ is the
   338	topological intersection number of the homology class
   339	$[L]\in H_2(\CP^2;\mathbb Z)$ with itself, equal to $1$ regardless
   340	of the symplectic form used (it only depends on the underlying
   341	oriented smooth pair $(\CP^2,L)$): contradiction. Hence no such $J$
   342	exists after any allowed deformation either. For
   343	$D=L_1\cup L_2$ formed by two distinct lines: they meet transversely
   344	at one point, and the standard local Darboux model for two
   345	transversally intersecting symplectic hypersurfaces supplies the SNC
   346	charts at the intersection point, so $D$ is a symplectic SNC divisor
   347	in the sense of the question; each component satisfies
   348	$L_i\cdot L_i=1$, so the same conclusion holds.
   349	\end{proof}
   350	
   351	\section{Discussion of sharpness}\label{sec:remarks}
   352	
   353	\noindent(1) \emph{What the obstruction uses.} Only the existence of
   354	local $J$-holomorphic defining functions and the compactness of the
   355	component enter: the ratio lemma makes the conormal frames constant
   356	along the component via the maximum principle. Tameness of $J$,
   357	closedness of $M$, and the SNC condition beyond smoothness of the
   358	component are superfluous for the obstruction --- but $(\CP^2,L)$
   359	satisfies all the hypotheses of the question, so the answer to the
   360	question as stated is no.
   361	
   362	\noindent(2) \emph{The deformation does not help because the
   363	obstruction is not symplectic.} Theorem~\ref{thm:obstruction} is a
   364	statement about $J$ and $D$ alone (given adaptedness); its
   365	conclusion $D_\alpha\cdot D_\alpha=0$ is a topological fact of the
   366	pair. No change of $\omega$ within its cohomology class (or any
   367	class) affects it, as long as $D_\alpha$ stays compact.
   368	
   369	\noindent(3) \emph{Sharpness of the principle.} The obstruction
   370	vanishes when $D_\alpha\cdot D_\alpha=0$; in product situations
   371	(e.g.\ $D=X\times\{0\}\subset X\times\Sigma^g$ with product form,
   372	where $\nu_D$ is trivial) adapted tame structures do exist
   373	($J_X\oplus$ standard), so no obstruction-free statement can
   374	distinguish those cases with the invariant used here; whether the
   375	answer is yes whenever all components have vanishing normal Euler
   376	class is a further question not decided here.
   377	
   378	\noindent(4) \emph{More counterexamples.} Any closed symplectic
   379	$(M,\omega)$ containing a symplectic SNC divisor with a compact
   380	connected component $D_\alpha$ of nonzero self-intersection is a
   381	counterexample: a line in $\CP^2$ (self-intersection $+1$), an
   382	exceptional sphere in a symplectic blow-up (self-intersection $-1$),
   383	a smooth fibre... note the fibre of a ruled surface has
   384	self-intersection $0$, which does not obstruct; the anti-canonical
   385	divisor in toric Fano symplectic manifolds has components with
   386	nonzero pairing in many cases. In each case the answer to the
   387	question is negative, stably under the allowed deformation.
   388	
