    23	\title{On tame almost complex structures adapted to symplectic\\
    24	simple normal crossings divisors:\\ a self-intersection obstruction}
    25	\author{}
    26	\date{}
    27	\maketitle
    28	
    29	\begin{abstract}
    30	\noindent We prove that the answer to the question is \emph{no} in
    31	general. If $(M,\omega)$ is a symplectic manifold, $D\subset M$ a
    32	symplectic simple normal crossings divisor, and $J$ an $\omega$-tame
    33	almost complex structure admitting, locally on $M$, smooth complex
    34	coordinates $(z_1,\ldots,z_n)$ with $z_1,\ldots,z_r$
    35	$J$-holomorphic and $D=\{z_1\cdots z_r=0\}$, then the normal bundle
    36	of every compact connected component $D_\alpha$ of $D$ admits a flat
    37	structure with locally constant (locally) $J$-holomorphic trivialising
    38	frames; in particular
    39	\[
    40	\langle e(\nu_{D_\alpha}),[D_\alpha]\rangle\ =\
    41	D_\alpha\cdot D_\alpha\ =\ 0 .
    42	\]
    43	For a projective line $L\cong\CP^1$ in $(\CP^2,\omega_{\mathrm{FS}})$
    44	(a symplectic SNC divisor with one component) one has $L\cdot L=1$,
    45	so no such $J$ exists, and the cohomologous deformation of $\omega$
    46	allowed in the question cannot remove the obstruction, which is
    47	topological in the pair $(M,D)$.
    48	\end{abstract}
    49	
    50	\section{Statement and answer}\label{sec:statement}
    51	
    52	\begin{quote}
    53	\textbf{Question.} Let $(M,\omega)$ be a closed symplectic manifold
    54	and $D\subset M$ a symplectic simple normal crossings divisor. Does
    55	there exist an $\omega$-tame almost complex structure $J$ such that
    56	locally on $M$ there are smooth complex coordinates $(z_1,\ldots,z_n)$
    57	in which, for some $0\le r\le n$, the functions $z_1,\ldots,z_r$ are
    58	$J$-holomorphic and $D$ is given by $z_1\cdots z_r=0$? (One may first
    59	replace $\omega$ by a symplectic form connected to it through a path
    60	of symplectic forms, all cohomologous to $\omega$, along which $D$
    61	remains a symplectic simple normal crossings divisor.)
    62	\end{quote}
    63	
    64	\medskip
    65	\noindent\textbf{Answer: No in general.} The precise form is:
    66	
    67	\begin{theorem}[Obstruction]\label{thm:obstruction}
    68	Let $(M,\omega)$ be a symplectic manifold, $D\subset M$ a symplectic
    69	simple normal crossings divisor, and let $J$ be an almost complex
    70	structure on $M$ which is \emph{SNC-adapted to} $D$, meaning: every
    71	point $p\in M$ has a neighbourhood $U$ with smooth complex
    72	coordinates $(z_1,\ldots,z_n)\colon U\to U'\subset\CC^n$ such that,
    73	for some $0\le r\le n$,
    74	\begin{enumerate}
    75	\item[\normalfont(i)] $D\cap U=\{q\in U:z_1(q)\cdots z_r(q)=0\}$;
    76	\item[\normalfont(ii)] $z_1,\dots,z_r$ are $J$-holomorphic on $U$
    77	(the condition $\dd z_k\circ J=i\,\dd z_k$ holds at every point of
    78	$U$).
    79	\end{enumerate}
    80	Let $D_\alpha$ be a compact connected component of $D$. Then the
    81	normal bundle $\nu_\alpha$ of $D_\alpha$ in $M$ --- a complex line
    82	bundle via the quotient of $J$, see Lemma~\ref{lem:strata} ---
    83	possesses a flat connection; in particular its Euler class satisfies
    84	\[
    85	e(\nu_\alpha)\ =\ 0\ \in\ H^2(D_\alpha;\RR),
    86	\qquad\text{hence}\qquad
    87	\langle e(\nu_\alpha),[D_\alpha]\rangle
    88	\ =\ D_\alpha\cdot D_\alpha\ =\ 0 .
    89	\]
    90	(The conclusion of the question would therefore force
    91	$D_\alpha\cdot D_\alpha=0$ for every compact component, regardless
    92	of the tameness of $J$ --- the latter enters the question but the
    93	obstruction needs no taming at all.)
    94	\end{theorem}
    95	
    96	\begin{corollary}[The counterexample]\label{cor:cp2}
    97	Let $M=\CP^2$, $\omega=\omega_{\mathrm{FS}}$ the Fubini--Study
    98	symplectic form, and $D=L\cong\CP^1$ a projective line. Then $D$ is
    99	a symplectic simple normal crossings divisor in the closed symplectic
   100	manifold $(M,\omega)$: it is a smooth symplectic submanifold, and a
   101	single component trivially constitutes simple normal crossings. But
   102	\[
   103	L\cdot L\ =\ \int_L c_1\bigl(\mathcal O_{\CP^1}(1)\bigr)\ =\ 1
   104	\ \neq\ 0 ,
   105	\]
   106	since $\nu_L\cong\mathcal O_{\CP^1}(1)$. By
   107	Theorem~\ref{thm:obstruction}, no $\omega'$-tame SNC-adapted $J$
   108	exists for \emph{any} symplectic form $\omega'$ in a cohomologous
   109	deformation family: the quantity $\langle e(\nu_L),[L]\rangle=L\cdot
   110	L$ is a topological intersection number of the pair $(M,L)$, hence
   111	unchanged by any deformation of $\omega$ that keeps $L$ smoothly
   112	embedded (and a fortiori symplectic SNC). Moreover, the same
   113	conclusion holds for the nodal SNC divisor $D=L_1\cup L_2$ formed by
   114	two distinct lines: each component satisfies
   115	$L_i\cdot L_i=1$.
   116	\end{corollary}
   117	
   118	\begin{remark}[What would happen for null-homologous-normal
   119	components]
   120	For components with normal bundle of real-Euler-class zero (e.g.\
   121	trivial normal bundle), Theorem~\ref{thm:obstruction} says nothing;
   122	and indeed in the product situation $M=X\times\CC$ with
   123	$D=X\times\{0\}$ an $\omega$-tame adapted $J$ does exist whenever
   124	$(X,\omega|_X)$ carries a tame almost complex structure $J_X$: take
   125	$J=J_X\oplus i$. This shows the obstruction found here is specific
   126	to components with nontrivial normal Euler class, and the
   127	counterexample relies on $L\cdot L\neq0$.
   128	\end{remark}
   129	
   130	\section{Strata are $J$-invariant}\label{sec:strata}
   131	
   132	\begin{lemma}\label{lem:strata}
   133	Let $J$ be SNC-adapted to $D$ (no taming assumption needed). Then
   134	for every $p\in D$, and $A:=\{\alpha:p\in D_\alpha\}$, the tangent
   135	space $T_pD_A$ of the stratum $D_A=\bigcap_{\alpha\in A}D_\alpha$
   136	is a $J_p$-complex subspace of $T_pM$. Consequently
   137	$J_A:=J|_{TD_A}$ is an almost complex structure on $D_A$, and, if
   138	$J$ is $\omega$-tame, so is $J_A$ (with respect to
   139	$\omega|_{D_A}$).
   140	\end{lemma}
   141	
   142	\begin{proof}
   143	Choose adapted coordinates $(z_1,\dots,z_n)$ at $p$ with
   144	$D\cap U=\{z_1\cdots z_r=0\}$, so that $D_A\cap U=\{z_{k}=
   145	0:\alpha_k\in A\}$ after numbering, and
   146	$T_pD_A=\bigcap_{k:\,\alpha_k\in A}\ker\dd z_k(p)$. For
   147	$v\in\ker\dd z_k(p)$, the $J$-holomorphicity of $z_k$ gives
   148	$\dd z_k(Jv)=i\,\dd z_k(v)=0$, so $Jv\in\ker\dd z_k(p)$. Thus each
   149	$\ker\dd z_k(p)$ is $J_p$-invariant, and so is their intersection.
   150	The statement about taming restricts from $M$ to the invariant
   151	subspace: for $v\in T_pD_A\setminus0$,
   152	$\omega(v,J_Av)=\omega(v,Jv)>0$.
   153	\end{proof}
   154	
   155	\begin{corollary}[Normal bundle is a complex line bundle]
   156	\label{cor:normal}
   157	For any component $D_\alpha$, the normal bundle
   158	$\nu_\alpha:=TM|_{D_\alpha}/TD_\alpha$ carries a fibrewise complex
   159	structure induced by $J$, making it a complex line bundle over
   160	$D_\alpha$; the conormal bundle $\nu_\alpha^*=\Hom_\CC(\nu_\alpha,
   161	\CC)$ is the dual complex line bundle.
   162	\end{corollary}
   163	
   164	\section{The ratio lemma}\label{sec:ratio}
   165	
   166	\begin{lemma}[Ratios are $J$-holomorphic across the divisor]
   167	\label{lem:ratio}
   168	Let $J$ be SNC-adapted, and let $\zeta,\zeta'$ be $J$-holomorphic
   169	functions on a connected open set $W\subset M$ with
   170	\[
   171	\{\zeta=0\}\ =\ \{\zeta'=0\}\ =\ W\cap D_\alpha,
   172	\qquad \dd\zeta\neq0,\ \dd\zeta'\neq0\ \text{on }W\cap D_\alpha .
   173	\]
   174	Then the ratio $h:=\zeta'/\zeta$, smooth and nonvanishing on
   175	$W\setminus D_\alpha$, extends to a smooth nonvanishing function on
   176	$W$, the extension satisfies
   177	\begin{equation}\label{eq:cross}
   178	\dd\zeta'\ =\ h\,\dd\zeta\quad\text{on }W\cap D_\alpha,
   179	\end{equation}
   180	and $h$ is $J$-holomorphic on $W$: $\dd h\circ J=i\,\dd h$.
   181	\end{lemma}
   182	
   183	\begin{proof}
   184	Off $D_\alpha$, both functions are nowhere zero, so $h$ is smooth
   185	nonvanishing there, and the computation
   186	$\dd\zeta'=\dd h\,\zeta+h\,\dd\zeta$ composed with $J$ gives, using
   187	$\dd\zeta\circ J=i\dd\zeta$ and $\dd\zeta'\circ J=i\dd\zeta'$,
   188	\[
   189	0\ =\ \zeta\cdot\bigl(\dd h\circ J-i\,\dd h\bigr),
   190	\]
   191	hence $\dd h\circ J=i\dd h$ on $W\setminus D_\alpha$: $h$ is
   192	$J$-holomorphic there.
   193	
   194	For the extension: $D_\alpha\cap W$ is a smooth codimension-two
   195	submanifold along which both $\zeta,\zeta'$ vanish with nonvanishing
   196	differential transversely. In any tubular neighbourhood with normal
   197	coordinate, both ${\zeta}$ and ${\zeta}'$ have a simple zero along
   198	the zero section; their quotient extends smoothly and nonvanishingly
   199	across the zero section (one-variable Taylor argument in the normal
   200	direction: if $f(t)=t\,F(t)$, $g(t)=t\,G(t)$ with $F(0),G(0)\neq0$,

