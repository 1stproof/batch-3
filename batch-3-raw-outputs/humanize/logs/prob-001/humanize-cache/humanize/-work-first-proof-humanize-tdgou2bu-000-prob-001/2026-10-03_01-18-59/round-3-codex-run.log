\begin{lemma}[The dead level]\label{lem:dead}
For the dead object $D=(P\to\{0\})$: $\mathcal G$ is constant equal
to $F(b_P)$ on its slice, every cover's pieces all lie over $D$, and
$H^0(D,\mathcal G)=F(b_P)$, $H^{q\ge1}(D,\mathcal G)=0$ by
Lemma~\textup{\ref{lem:const}} applied within each cover
\textup{(}equivalently: sheaf cohomology on a slice category with an
initial object, on a constant sheaf, vanishes in positive
degrees\textup{)}.
\end{lemma}

\begin{proof}
Every piece over $D$ has kernel $\supseteq\Phi_D=P$: all dead; the
slice $A_P/D$ has $D$ initial; compatible systems are pinned by
identity transitions to constants; the \v{C}ech complexes are the
constant-strand ones of Lemma~\ref{lem:const}.
\end{proof}

\begin{lemma}[Filter lemma]\label{lem:filter}
Let $\Xi$ be a finite poset of levels with a unique largest
element $\top$, and let $R$ be a cover of $X$ with a presheaf
$\mathscr W$ whose pieces carry order-respecting
$\Xi$-labels---every structure map
$\overline\tau\to\overline{\tau'}$ has
$\operatorname{lev}(\overline\tau)\XiLe
\operatorname{lev}(\overline{\tau'})$, so by
Lemma~\ref{lem:depth} each face of a nerve piece has label
$\XiLe$ the piece's label. Suppose:
\textup{(}F1\textup{)} the top level $\top$ is a
differential-closed constant strand with a minimum piece
\textup{(}Lemma~\ref{lem:constcx}\textup{)}: $\mathscr W$ is
constant equal to a single $A$ on $\top$-nerve pieces, all
structure maps among them inducing $\mathrm{id}_A$, and a fixed
piece $H_\top$ maps to every $\top$-piece;
\textup{(}F2\textup{)} every nerve piece labelled $\top$ arises
by adjoining to a lower-labelled tuple $\tau$ a piece $U$ whose
structure map factors through $H_\top$, with
$\overline{(U,\tau)}$ again $\top$-labelled; the piece $U$ is a
fold whose structure map's image lies in the kernel of the
transport $\mathscr W(\overline\tau\cup U)\to\mathscr
W(\overline\tau)$ \textup{(}the \emph{dead-adjunction
hypothesis}\textup{)}.
If $z$ is a degree-$q\ge1$ cocycle whose value at every
$\top$-labelled nerve piece vanishes, then $z$ is cohomologous,
within the same cover, to a cocycle supported on labels
$\XiLt\top$ \textup{(}the next-level values being the signed
transports of Lemma~\ref{lem:subquot}\textup{)}; iterating down
the finite poset, $z$ pulls \textup{(}after no refinement: at
the level of cocycles\textup{)} to a cocycle supported at the
initial level.
\end{lemma}

\begin{proof}
Define, for a lower tuple $\tau$ \textup{(}all labels
$\XiLt\top$\textup{)}, a cochain $h$ on $\top$-pieces by
$(he)_{(U,\tau)}:=e_{\tau}$ when (F2) applies
\textup{(}transported: $e_\tau$ lies at the lower level; the
value is its image at $\overline{(U,\tau)}$, well-defined since
the map $\overline{(U,\tau)}\to\overline\tau$ has constant
transport by (F2)'s factoring through $H_\top$
\textup{)}. Then the cocycle equation
$(\partial z)_{(U,\tau)}=0$ reads, isolating the face omitting
$U$,
\[
z_\tau\ \text{\textup{(}transported\textup{)}}\ =\
\sum_{i}(-1)^{i+1}\,\mathscr W(d_i)\bigl(z_{(U,\partial_i\tau)}\bigr)
\quad\text{on }\top\text{-pieces},
\]
whose right side is $(\partial h z)_{(U,\tau)}$: precisely the
constant-complex contraction of Lemma~\ref{lem:constcx} run
against the anchor $H_\top$. Subtracting $\partial(hz)$---a
coboundary supported on $\top$ by (F1)---removes the
$\top$-component, and by Lemma~\ref{lem:subquot} the cocycle is
now supported one level lower, the next-level values shifted by
the signed transport. Finiteness of $\Xi$ terminates the
descent at the initial level.
\end{proof}

\begin{lemma}[Sieve: fold terraces and face pins]\label{lem:sieve}
Let $R$ be a standard rigid cover of $i(b)$ and $z$ a $\mathcal
G$-\v{C}ech cocycle of degree $q\ge1$ on $R$.
\textup{(}i\textup{)} $z$ is cohomologous within $R$ \textup{(}no
refinement\textup{)} to a cocycle vanishing at every nerve piece
containing a kernel-$J$ fold \textup{(}the dead sector is left
arbitrary\textup{)}.
\textup{(}ii\textup{)} For every face $K\supsetneq J$: if $z$
vanishes at every nerve position of level strictly larger than
$K$, then its values at the $K$-exact positions are pinned, after
the canonical transports, to a single element
$\widehat z_K\in F(B(i(P/K)))=F(P/K)$ \textup{(}the \emph{sieve
constant} at $K$\textup{)}.
\end{lemma}

\begin{proof}
(i) A kernel-$J$ fold is a tight functional
$\varphi:\bar P\to\mathbb N$; up to rational multiple it is a
point of the pointed, strictly convex rational polyhedral cone
$\Cone(\bar P)^{\vee}$, which is a finite rational fan, so there
are finitely many fold \emph{rays} in $R$: enumerate them
$\mathfrak f_1,\dots,\mathfrak f_m$. For a ray index $r$ define
the \emph{$r$-fold strand} as the cochains supported on tuples
containing $\mathfrak f_r$ but no fold from a later ray
$s>r$ and no fold on a different ray than $r$. On such a tuple
$\tau=(\mathfrak f_r,\tau')$ every position of $\tau'$ has
kernel $\subseteq J$ \textup{(}it is $iB$ or a fold on ray
$r$\textup{)}, so by Lemma~\ref{lem:nerve}(i) Case A and
Lemma~\ref{lem:mixed}(C1) the overlap
$\overline\tau=\mathfrak f_r\otimes\overline{\tau'}$ still has
kernel $J$, and all structure maps among these pieces induce the
identity on $\mathcal G$-values $F(b)$. The $r$-fold strand is
therefore a constant strand on which adjoining $\mathfrak f_r$
is internal \textup{(}the face omitting an element of $\tau'$
still contains $\mathfrak f_r$\textup{)}; by the constant-complex
Lemma~\ref{lem:constcx} with anchor $H=\mathfrak f_r$ it is
acyclic in degrees $\ge1$: the cocycle's component on it is
$\partial w_r$. The strands for distinct $r$ are disjoint
\textup{(}a tuple containing two distinct-ray folds lies in
none\textup{)} and their union is differential-closed, so by
repeated application of the exact-subquotient
Lemma~\ref{lem:subquot} the cocycle $z-\partial(\sum_r w_r)$ is
supported on tuples containing \emph{no} kernel-$J$ fold, as
claimed. The dead tuples \textup{(}two distinct-ray folds, or a
fold against a face $\supsetneq J$\textup{)} are never touched.
\textup{(}ii\textup{)} Two $K$-exact positions $W_1,W_2$ are
connected through the chain $W_1,i(P/K),W_2$: the overlaps
$W_i\otimes i(P/K)$ have level $K$ or strictly larger
(Lemma~\ref{lem:nerve}(ii), Lemma~\ref{lem:mixed}(C2): the join
$\Phi\vee K$ equals $K$ exactly when $\Phi\subseteq K$). By
hypothesis the strictly-larger values vanish, so the cocycle
relation at the pair $(W_i,i(P/K))$ forces
$z_{W_i}=F(\text{quotient }B(W_i)\twoheadrightarrow
P/K)^{-1}\text{-transport}(z_{i(P/K)})$; all transports being the
canonical quotient maps, every $K$-exact value equals the single
$z_{i(P/K)}$-value transported, i.e.\ they are pinned to one
$\widehat z_K$.
\end{proof}

\begin{lemma}[Common refinement of covers]\label{lem:sandwich}
Let $R=\{U_\alpha\}$ and $S=\{V_\beta\}$ be covers of $i(b)$ in
the sliced birhizomic site. Then
$R^\flat:=\{U_\alpha\otimes_{i(b)}V_\beta\}_{\alpha,\beta}$ is a
cover of $i(b)$ refining both $R$ and $S$
\textup{(}via the structure maps to $U_\alpha$ and to
$V_\beta$\textup{)}; in particular the \v{C}ech colimit of
Remark~\ref{rem:verdier} is directed.
\end{lemma}

\begin{proof}
The birhizomic topology is a pretopology: its coverings are
stable under pullback and composition
\textup{(}Remark~\ref{rem:cover-points}; the pushouts exist by
Construction~\ref{constr:pushout}\textup{)}. For each fixed
$U_\alpha$ the family $\{U_\alpha\otimes_{i(b)}V_\beta\}_\beta$
is the pullback of the cover $S$ along $U_\alpha\to i(b)$, hence
a cover of $U_\alpha$; composing these over the cover
$R=\{U_\alpha\}$ of $i(b)$, the family
$\{U_\alpha\otimes_{i(b)}V_\beta\}_{\alpha,\beta}$ covers
$i(b)$. It refines $R$ and $S$ via the two structure maps
$U_\alpha\otimes V_\beta\to U_\alpha$ and
$U_\alpha\otimes V_\beta\to V_\beta$ given by the pushout
universal property.
\end{proof}

\begin{lemma}[Restriction to a face slice]\label{lem:restrict}
Let $K\supsetneq J$ be a face and $R$ a standard rigid cover of
$i(b)$. There is a cover $R_K$ of $i(P/K)$ refining
$\{U\otimes_{i(b)}i(P/K):U\in R\}$ whose every $K$-exact piece
$W$ satisfies:
\textup{(}i\textup{)} the transition
$\mathcal G(W)\to\mathcal G(W\otimes iB)$ is the identity of
$F(P/K)$ \textup{(}as $\Phi_{W\otimes iB}=\Phi_W=K$,
Lemma~\textup{\ref{lem:mixed}(C1)}\textup{)};
\textup{(}ii\textup{)} $W\otimes iB=\overline{(W,iB)}$ is a nerve
piece of $R$ at exactly level $K$;
\textup{(}iii\textup{)} hence a cocycle $z_K$ on $R_K$ over
$i(P/K)$ pulls back to $R$ with $K$-exact pinned constant
$\widehat z_K\in F(P/K)$ equal to $z_K(W)$ for any $K$-exact $W$.
\end{lemma}

\begin{proof}
$\{U\otimes i(P/K)\}$ is the pullback of the cover $R$ along
$i(P/K)\to i(b)$, a cover of $i(P/K)$ by the pretopology
(Lemma~\ref{lem:sandwich} with the singleton cover
$\{i(P/K)\}$). Put it in standard rigid form over $i(P/K)$
(Definition~\ref{def:square}: normal form
Theorem~\ref{thm:normalform}, probes
Corollaries~\ref{cor:probecover}/\ref{cor:probecovers},
surjectivity Lemma~\ref{lem:surj}, rigidification), keeping a
$K$-exact CFA piece $i(P/K)$ itself as a member---the refined
family still maps to $\{U\otimes i(P/K)\}$ since every
intersection with $i(P/K)$ survives. For a $K$-exact piece $W$:
(i) $W$ and $W\otimes iB$ both have kernel $K$ (adjoining the
kernel-$J$ fold-quotient $iB$ does not grow the kernel by
Lemma~\ref{lem:mixed}(C1)), so the structure map
$W\to W\otimes iB$ induces the identity on $F(P/K)$; (ii)
$W\otimes iB=\overline{(W,iB)}$ is a nerve piece of the original
cover $R$; (iii) is then the reading of Lemma~\ref{lem:sieve}(ii)
at level $K$.
\end{proof}

\begin{proposition}\label{prop:vanish}
$H^0(i(b),\mathcal G)=F(b)$ and $H^q(i(b),\mathcal G)=0$ for
$q>0$.
\end{proposition}

\begin{proof}
By the comparison theorem (Remark~\ref{rem:verdier}),
$H^q(i(b),\mathcal G)=\colim_R\HH^q(R;\mathcal G)$ over the nerves
of Definition~\ref{def:nerve}, the colimit taken over the standard
rigid covers (cofinal by Definition~\ref{def:square}), which form a
directed system by the common-refinement
Lemma~\ref{lem:sandwich}. We prove
$\HH^0(i(b),\mathcal G)=F(b)$---true already on the nose:
$\mathcal G$ is a sheaf (Theorem~\ref{thm:descent}) and
$\mathcal G(i(b))=F(b)$ (Proposition~\ref{prop:adj})---and that
every class $[z]\in\HH^{q\ge1}(R;\mathcal G)$ pulls to zero on a
further refinement. We work one degree $q\ge1$ at a time,
associating to a $q$-cocycle its $(q-1)$-\emph{faces} (the values
$z_{(U_0,U_1)}$), and use the sheaf axiom at each step to descend.
For $\bar P=\{0\}$ the slice is the dead level and
Lemma~\ref{lem:dead} gives the vanishing; for $\dim\bar P\le1$ the
whole nerve of a standard rigid cover is the constant strand with
minimum $iB$, so Lemma~\ref{lem:const}
($R_{\min}=R_{\max}=iB$) gives $\HH^{q\ge1}=0$ directly (these are
the base cases). Assume now $\dim\bar P\ge2$.

\emph{Step 1 (dead-sector hygiene).} Let $R$ be a standard rigid
cover. The sifted family $S:=\{U\otimes_{i(b)}D:U\in R\}$ is the
pullback of $R$ along $D\to i(b)$, hence a cover of $D$
(Lemma~\ref{lem:sandwich}); pass to the common refinement of $R$
and $S$ (Lemma~\ref{lem:sandwich} again) and keep the notation
$R$, $z$. Every nerve piece of $S$ is dead, and on the slice over
$D$ the sheaf $\mathcal G$ is the constant sheaf $F(b_P)$
(Lemma~\ref{lem:dead}); by the constant-complex
Lemma~\ref{lem:constcx} with anchor $H=D$, the restricted cocycle
is a coboundary: $z|_S=\partial w$ for a $(q-1)$-cochain $w$ on
$S$. Pulling $w$ back to $R$ along the refinement map, we may
subtract $\partial w$ from $z$; hence after this refinement
\[
\text{the value of }z\text{ at every nerve piece that maps to }D
\text{ is the value of a coboundary with coefficients in }F(b_P).
\tag{$\ast$}
\]
We assert nothing further about the dead sector; we do not pin it
to a single constant.

\emph{Step 2 (the terminal images of the folds agree).}
Apply Lemma~\ref{lem:sieve}(i) to $z$: it is cohomologous within
$R$ to a cocycle vanishing at every nerve piece containing a
kernel-$J$ fold; replace $z$ by this representative. In particular
$z_{\mathfrak f}=0$ for every kernel-$J$ fold $\mathfrak f$. For
two kernel-$J$ folds $\mathfrak f,\mathfrak f'$ on distinct rays
(available since $\dim\bar P\ge2$) the pairs
$(\mathfrak f,\mathfrak f')$, $(\mathfrak f,D)$,
$(\mathfrak f',D)$ are dead (Lemma~\ref{lem:mixed}(a),
Lemma~\ref{lem:nerve}(i)). Their cocycle values at degree
$q-1$ are, by $(\ast)$, coboundary values in $F(b_P)$:
$z_{(\mathfrak f,D)}=(\partial w)_{(\mathfrak f,D)}$ etc. The
values of a $q$-cocycle at the dead $(q-1)$-faces, being
coboundaries, impose no constraint beyond Step~1; the content we
retain is the equality of terminal images, already forced at the
sheaf level in Theorem~\ref{thm:descent}:
$F(\iota_{\mathfrak f})(z_{\mathfrak f})
=F(\iota_{\mathfrak f'})(z_{\mathfrak f'})=0$ in $F(b_P)$
since $z_{\mathfrak f}=z_{\mathfrak f'}=0$. (Here $\iota_W$ is the
terminal map $B(W)\to b_P$; the identification
$\bar\chi^{\gp}((K/J)^{\gp})=d\Z$, $d\ge1$, used in the kernel
computations is Lemma~\ref{lem:dlemma}.)

\emph{Step 3 (descending induction on faces).} We prove by
descending induction on the face $K\supseteq J$ that, after
refinement, $z$ is cohomologous to a cocycle vanishing at every
nerve position of level $\supsetneq K$; the base $K=P$ (dead
level) is Step~1's $(\ast)$ together with Lemma~\ref{lem:sieve}(i)
(all fold terraces already vanish). For the inductive step suppose
$z$ vanishes at all levels strictly larger than $K$, so by
Lemma~\ref{lem:sieve}(ii) the $K$-exact values are pinned to a
single $\widehat z_K\in F(P/K)$. \emph{First, its image dies:} the
pair $(\mathfrak f,i(P/K))$ for a kernel-$J$ fold $\mathfrak f$ is
dead (Lemma~\ref{lem:nerve}(i)), so its value is a coboundary
value by Step~1's $(\ast)$, and the cocycle relation at that pair
reads $F(\iota_{i(P/K)})(\widehat z_K)
=F(\iota_{\mathfrak f})(z_{\mathfrak f})$ in $F(b_P)$; as
$z_{\mathfrak f}=0$ (Step~2) the right side is $0$, and
$\iota_{i(P/K)}=\pi_{K\to P}$, hence
\[
F(\pi_{K\to P})(\widehat z_K)=0\qquad\text{in }F(b_P).
\tag{$\dagger$}
\]
\emph{Then the constant itself dies:} restrict the cover to the
slice over $i(P/K)$ (Lemma~\ref{lem:restrict}). The restricted
cocycle $z_K$ has, by Lemma~\ref{lem:restrict}(iii), its
$K$-exact constant equal to $\widehat z_K$; on the slice, the
piece $i(P/K)$ and its overlap with $iB$ have kernel exactly
$K$, and a $K$-exact face piece on the slice is precisely
$\overline{(W,iB)}$ for $W$ $K$-exact in $R$. The induction
hypothesis $D(K)$---vanishing of the same cohomology in the
degree one \emph{lower}, applied to the sheaf $\mathcal G_K$ on
the initial-object slice (Theorem~\ref{thm:descent} with
$T=i(P/K)$)---kills the face-values of $z_K$ at the
strictly-above-$K$ positions after one more refinement
(Remark~\ref{rem:transfer}); what remains on the slice is the
single class $\widehat z_K$ carried by $i(P/K)$. But
$(\dagger)$ says its only outward transition
$F(\pi_{K\to P})$ is zero, so $\widehat z_K$ is a class on the
constant-one-object strand that is annihilated; pulling back once
more (Remark~\ref{rem:transfer}) gives $\widehat z_K=0$. Thus $z$
vanishes at all $K$-exact positions, and the induction descends.

\emph{Step 4 (residuum and descent).} After the induction reaches
$K=J$ the cocycle vanishes at every nerve position of level
$\supsetneq J$, i.e.\ at every position containing a piece whose
kernel strictly contains $J$; the remaining positions have every
kernel equal to $J$, on which $\mathcal G$ is the constant sheaf
$F(b)$ with all transitions $F(\mathrm{id})$. On this residuum the
$\check H^{q\ge1}$ vanish and $\check H^0=F(b)$ by
Lemma~\ref{lem:const} ($R_{\min}=iB$, $R_{\max}=iB$). Since every
operation was a pullback along a refinement
(Remark~\ref{rem:transfer}) or subtraction of a coboundary within
one cover, $[z]=0\in\colim_R\HH^{q\ge1}(R;\mathcal G)$, and the
degree-$0$ assertion $\HH^0(i(b),\mathcal G)=F(b)$ is
Theorem~\ref{thm:descent} and Proposition~\ref{prop:adj}
\textup{(}no circularity: descent was proved independently in
\S\ref{sec:sheaf}\textup{)}. This completes the induction on $q$.
\end{proof}

\begin{theorem}\label{thm:main-end}
$\mathrm{R}^0\pi_*(\pi^{-1}F)=F$ and
$\mathrm{R}^q\pi_*(\pi^{-1}F)=0$ for all $q>0$; hence
$\eta_F:F\to\mathrm{R}\pi_*\pi^{-1}F$ is a quasi-isomorphism.
\qed
\end{theorem}

\begin{proof}[Proof (summary)]
$\mathrm{R}^q\pi_*\mathcal G$ is the sheaf on $B_P^{\op}$
associated to $b\mapsto H^q(i(b),\mathcal G)$; with the trivial
topology sheaves = presheaves; values $H^0(i(b),\mathcal G)
=\mathcal G(i(b))=F(b)$ (Theorem~\ref{thm:descent},
Proposition~\ref{prop:adj}), $H^{q>0}=0$
(Proposition~\ref{prop:vanish}) \checkmark. Together with the unit being
the identity sheaf map $F\to\pi_*\mathcal G$ on $B_P$
(Theorem~\ref{thm:descent}), this proves Theorem~\ref{thm:main}.
\end{proof}

