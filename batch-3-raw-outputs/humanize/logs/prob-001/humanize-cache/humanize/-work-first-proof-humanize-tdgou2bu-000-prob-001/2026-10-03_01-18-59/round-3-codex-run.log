\begin{lemma}[Restriction to a face slice]\label{lem:restrict}
Let $K\supsetneq J$ be a face and $R$ a standard rigid cover of
$i(b)$. There is a cover $R_K$ of $i(P/K)$ refining
$\{U\otimes_{i(b)}i(P/K):U\in R\}$ whose every $K$-exact piece
$W$ satisfies:
\textup{(}i\textup{)} the transition
$\mathcal G(W)\to\mathcal G(W\otimes iB)$ is the identity of
$F(P/K)$ \textup{(}as $\Phi_{W\otimes iB}=\Phi_W=K$,
Lemma~\textup{\ref{lem:mixed}(C1)}\textup{)};
\textup{(}ii\textup{)} $W\otimes iB=\overline{(W,iB)}$ is a nerve
piece of $R$ at exactly level $K$;
\textup{(}iii\textup{)} hence a cocycle $z_K$ on $R_K$ over
$i(P/K)$ pulls back to $R$ with $K$-exact pinned constant
$\widehat z_K\in F(P/K)$ equal to $z_K(W)$ for any $K$-exact $W$.
\end{lemma}

\begin{proof}
$\{U\otimes i(P/K)\}$ is the pullback of the cover $R$ along
$i(P/K)\to i(b)$, a cover of $i(P/K)$ by the pretopology
(Lemma~\ref{lem:sandwich} with the singleton cover
$\{i(P/K)\}$). Put it in standard rigid form over $i(P/K)$
(Definition~\ref{def:square}: normal form
Theorem~\ref{thm:normalform}, probes
Corollaries~\ref{cor:probecover}/\ref{cor:probecovers},
surjectivity Lemma~\ref{lem:surj}, rigidification), keeping a
$K$-exact CFA piece $i(P/K)$ itself as a member---the refined
family still maps to $\{U\otimes i(P/K)\}$ since every
intersection with $i(P/K)$ survives. For a $K$-exact piece $W$:
(i) $W$ and $W\otimes iB$ both have kernel $K$ (adjoining the
kernel-$J$ fold-quotient $iB$ does not grow the kernel by
Lemma~\ref{lem:mixed}(C1)), so the structure map
$W\to W\otimes iB$ induces the identity on $F(P/K)$; (ii)
$W\otimes iB=\overline{(W,iB)}$ is a nerve piece of the original
cover $R$; (iii) is then the reading of Lemma~\ref{lem:sieve}(ii)
at level $K$.
\end{proof}

\begin{proposition}\label{prop:vanish}
$H^0(i(b),\mathcal G)=F(b)$ and $H^q(i(b),\mathcal G)=0$ for
