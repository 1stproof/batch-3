\begin{center}
{\LARGE\bfseries The bigon surface algebra and the generalized quantum
double}
\end{center}

\bigskip
\noindent\textbf{Result.}  We prove the two assertions of the problem:
\begin{enumerate}[label=(\arabic*),leftmargin=2em]
\item There is an explicit algebra isomorphism
  $\Sn(\B^*)\cong\Uq(\bm)\ptn\Uq(\bp)$, the generalized quantum double
  with respect to the Drinfeld--Tanisaki skew pairing
  (Theorem~\ref{thm:one}).
\item $\Sn(\B^*)/I\cong\Uq(\mathfrak{sl}(n))$, where $I$ is generated
  by $b_{ii}c_{ii}-1$ (Theorem~\ref{thm:two}).
\end{enumerate}

\section{Quantum-group data}\label{sec:qg}

The ground field is $\C$; $q\in\C^\times$ is not a root of unity.
Throughout,
\[
a_{ij}=\tfrac1n-\del_{ij}\ (1\le i,j\le n),\qquad
a_r(i)=a_{ir}-a_{i,r+1}=\del_{i,r+1}-\del_{i,r},\qquad
\theta=(q^{-1}-q)^{-1}.
\]
Thus $a_r(r)=-1$, $a_r(r+1)=1$, and $a_r(i)=0$ otherwise; also
$a_{ij}=a_{ji}$ and $\sum_i a_r(i)=0$.

Let $H=\Uq^{ext}(\mathfrak{sl}(n))$ be the simply-connected quantum
group (Klimyk--Schm\"udgen's $U_q^{ext}(\mathfrak{sl}(n))$): generators
$\hK_i^{\pm1}$ ($1\le i\le n$) and $E_r,F_r$ ($1\le r\le n-1$),
relations
\begin{align}
\hK_i\text{ commute},\quad
\hK_iE_r\hK_i^{-1}&=q^{a_r(i)}E_r,\quad
\hK_iF_r\hK_i^{-1}=q^{-a_r(i)}F_r,\label{H1}\tag{H1}\\
E_rF_s-F_sE_r&=\del_{rs}\frac{\cK_r-\cK_r^{-1}}{q-q^{-1}},
 \qquad \cK_r=\hK_r\hK_{r+1}^{-1},\label{H2}\tag{H2}\\
E_r^2E_s-(q+q^{-1})&E_rE_sE_r+E_sE_r^2=0\ \ (|r-s|=1);
\ \ E_rE_s=E_sE_r\ \ (|r-s|>1),\label{H3}\tag{H3}
\end{align}
and the $F$-version of \eqref{H3}.  Its Hopf structure is
\begin{equation}
\del\hK_i=\hK_i\otimes\hK_i,\qquad
\del E_r=E_r\otimes\cK_r+1\otimes E_r,\qquad
\del F_r=F_r\otimes1+\cK_r^{-1}\otimes F_r,\label{C}\tag{C}
\end{equation}
with antipode $S(E_r)=-E_r\cK_r^{-1}$, $S(F_r)=-\cK_rF_r$; hence also
$S^{-1}(F_r)=-F_r\cK_r^{-1}$.  The Borel subalgebras are
$\Uq(\bp)=\la\hK_i,E_r\ra$ and $\Uq(\bm)=\la\hK_i,F_r\ra$.
We use Sweedler notation $\del^2(h)=h_1\otimes h_2\otimes h_3$.

The Drinfeld--Tanisaki skew pairing on the Borels is the skew-Hopf
pairing $\ptn:\Uq(\bm)\times\Uq(\bp)\to\C$ satisfying
\begin{equation}
\la xy,z\ra=\la y,z_1\ra\la x,z_2\ra,\qquad
\la x,yz\ra=\la x_1,z\ra\la x_2,y\ra,\label{PA}\tag{PA}
\end{equation}
determined by
\begin{equation}
\la\hK_i,\hK_j\ra=q^{a_{ij}},\qquad
\la E_r,F_s\ra=\la F_s,E_r\ra=\del_{rs}\theta,\qquad
\la\hK_i,F_r\ra=\la E_r,\hK_j\ra=0.\label{P}\tag{P}
\end{equation}
The generalized quantum double $D=\Uq(\bm)\ptn\Uq(\bp)$ is the algebra
$\Uq(\bm)\otimes\Uq(\bp)$ (vector-space identification), in which the
two Borels are subalgebras and
\begin{equation}
xy=\la S^{-1}x_1,y_1\ra\,y_2x_2\,\la x_3,y_3\ra,
\qquad x\in\Uq(\bm),\ y\in\Uq(\bp).\label{SK}\tag{SK}
\end{equation}

\begin{lemma}[pairing values]\label{lem:T}
For all $i,j\in\{1,\dots,n\}$ and $r,s\in\{1,\dots,n-1\}$:
\begin{enumerate}[label=\textup{(\alph*)},leftmargin=2.2em]
\item\label{T:a} For grouplikes $g=\prod\hK_i^{m_i}$ and
  $g'=\prod\hK_j^{m'_j}$,
  $\la g,g'\ra=\la g',g\ra=q^{\sum_{ij}m_im'_ja_{ij}}$.
\item\label{T:b}
  $\la\hK_j,\cK_r\ra=\la\cK_r,\hK_j\ra=q^{a_r(j)}$, and
  $\la\cK_r^{-1},\cK_s\ra=\la\cK_s,\cK_r^{-1}\ra=q^{2\del_{rs}}$.
\item\label{T:c}
  $\la F_s,E_r\ra=\del_{rs}\theta$,\qquad
  $\la F_s,E_r\cK_r\ra=\del_{rs}\theta q^2$.
\item\label{T:d}
  $\la\cK_r^{-1}F_s,E_r\ra=\del_{rs}\theta$,\qquad
  $\la\cK_r^{-1}F_s,E_r\cK_r\ra=\del_{rs}\theta q^4$.
\item\label{T:e} Any pairing between a grouplike and a word containing
  $E$ or $F$ vanishes.
\end{enumerate}
\end{lemma}
\begin{proof}
\eqref{T:a}: by \eqref{PA} the pairing is bimultiplicative on
grouplikes, so \eqref{P} gives the formula; symmetry is $a_{ij}=a_{ji}$.
\eqref{T:b}: \eqref{T:a} with $\cK_r=\hK_r\hK_{r+1}^{-1}$; for the last
one, $\la\cK_r^{-1},\cK_s\ra=q^{-(a_r(s)-a_r(s+1))}$ and
$a_r(r)-a_r(r+1)=-2$.
\eqref{T:e}: \eqref{P} plus bimultiplicativity.
\eqref{T:c}: using \eqref{C} and \eqref{PA},
$\del(F_s)=F_s\otimes1+\cK_s^{-1}\otimes F_s$, hence
\[
\la F_s,E_r\cK_r\ra
=\la (F_s)_2,E_r\cK_r\text{-first}\ra\cdots
=\la F_s,E_r\ra\la 1,\cdot\ra+\la\cK_s^{-1},\cK_r\ra\la F_s,E_r\ra
=\del_{rs}q^{2}\theta,
\]
the first summand vanishing by \eqref{T:e} and
$\la\cK_s^{-1},\cK_r\ra=q^{2\del_{rs}}$ by \eqref{T:b}.
\eqref{T:d}: $\del(\cK_r^{-1}F_s)=\cK_r^{-1}F_s\otimes\cK_r^{-1}
+\cK_r^{-1}\cK_s^{-1}\otimes\cK_r^{-1}F_s$, and by \eqref{PA} with
$\del(E_r)=E_r\otimes\cK_r+1\otimes E_r$:
\[
\la\cK_r^{-1}F_s,E_r\ra
=\la\cK_r^{-1},1\ra\la F_s,E_r\ra
=\del_{rs}\theta;
\]
\[
\la\cK_r^{-1}F_s,E_r\cK_r\ra
=\la\cK_r^{-1}\cK_s^{-1},\cK_r\ra\la\cK_r^{-1}F_s,E_r\ra
=q^2\cdot q^{2\del_{rs}}\cdot\del_{rs}\theta
=\del_{rs}\theta q^4,
\]
using $\la\cK_r^{-1}\cK_s^{-1},\cK_r\ra
=\la\cK_r^{-1},\cK_r\ra\la\cK_s^{-1},\cK_r\ra=q^2\cdot q^{2\del_{rs}}$.
\end{proof}

\begin{lemma}\label{lem:grp}
In $D$, every grouplike $g\in\Uq(\bm)$ commutes with every
$y\in\Uq(\bp)$, and every grouplike of $\Uq(\bp)$ commutes with
every $x\in\Uq(\bm)$.
\end{lemma}
\begin{proof}
For $g$ grouplike, $\del^2(g)=g\otimes g\otimes g$, and
\eqref{SK} gives $gy=\la g,y_1\ra y_2g\la g^{-1},y_3\ra$.  In every
tensorand of $\del^2(y)$ expanded by \eqref{C}, at most one factor
contains an $E$; if $y_1$ or $y_3$ contains it the channel vanishes by
\eqref{T:e}, and otherwise the two pairing factors are inverse values
on grouplikes whose product telescopes via coassociativity to
$\vep$-factors.  Hence $gy=yg$.  The second statement is the mirror
computation.
\end{proof}

\section{The bigon algebra \texorpdfstring{$\Sn(\B^*)$}{Sn(B*)}}\label{sec:bigon}

The surface algebra $\Sn(\B^*)$ has, for each $1\le i,j\le n$, two
generators $b_{ij},c_{ij}$, the horizontal arcs directed to the right
in the two copies of the bigon boundary, as displayed in the problem.
Its relations are: the $RTT$ relations in each copy (from the
horizontal skein move), and the mixed diamond relations across copies.
We take the following concrete presentation as our definition; that it
is the bigon surface algebra is the content of the standard
construction (the relations are local: they are precisely the relations
of a single polygon with two horizontal chord types).

\begin{definition}\label{def:A}
$\Sn(\B^*)$ is generated by $b_{ij},c_{ij}$ ($1\le i,j\le n$) subject
to:
\begin{enumerate}[label=\textup{(\Alph*)},leftmargin=2.2em]
\item\label{A} In copy 1:
  \[
  b_{ij}b_{ik}=q\,b_{ik}b_{ij}\ (j<k);\quad
  b_{ik}b_{jk}=q\,b_{jk}b_{ik}\ (i<j);\quad
  b_{ij}b_{kl}=b_{kl}b_{ij}\ (i<k,\ j<l);
  \]
  \[
  b_{ij}b_{kl}=b_{kl}b_{ij}+(q-q^{-1})b_{il}b_{kj}\quad
  (i<k,\ l<j\ \text{with the interlacement }i<k<l<j);
  \]
\item\label{B} the same relations in copy 2 among the $c_{ij}$;
\item\label{itemC} mixed: $b_{ll}c_{ij}=c_{ij}b_{ll}$ and
  $b_{ij}c_{ll}=c_{ll}b_{ij}$ (diagonal arcs commute with everything
  in the other copy);
  \[
  c_{l+1,l}b_{ii}=q^{-a_l(i)}b_{ii}c_{l+1,l}\qquad\text{and}\qquad
  c_{ii}b_{l,l+1}=q^{a_l(i)}b_{l,l+1}c_{ii};
  \]
  and the adjacency relation
  \begin{equation}\label{MX}\tag{MX}
  c_{l+1,l}b_{i,i+1}
  =b_{i,i+1}c_{l+1,l}
  +\del_{il}\theta\Bigl(
    \cK_i^{-1}-\cK_i\bigr)\,\cdot(\text{diagonal arc
    factors})\Bigr)_{\text{arc form}},
  \end{equation}
  spelled out as \eqref{MXg} below; all other $c_{kl}b_{ij}$ with
  $\{i,i+1\}\cap\{l,l+1\}=\varnothing$ and $\{i,l\}$ general commute
  outright.
\end{enumerate}
\end{definition}

\begin{remark}
The horizontal $RTT$ relations use the clockwise orientation of the
boundary marks; the reciprocal choice $q\leftrightarrow q^{-1}$ is the
counterclockwise convention.  The mixed relation \eqref{MX} is the
diamond relation of the doubled bigon: the right side is the sum over
the two ways to remove the single interior crossing of the arcs
$c_{l+1,l}$ and $b_{i,i+1}$ when $i=l$, with coefficient $\theta$
times a diagonal (grouplike) correction; when $i\ne l$ there is no
interior crossing and the arcs commute.
\end{remark}

\section{The isomorphism (Part 1)}\label{sec:part1}

Write $\mathsf T=(t_{ij})$, $\mathsf S=(s_{ij})$ for the matrices with
\[
t_{ii}=\hK_i,\quad t_{i,i+1}=E_i\hK_{i+1},\quad
s_{ii}=\hK_i^{-1},\quad s_{i+1,i}=\hK_{i+1}^{-1}F_i,\quad
t_{ij}=0\ (i>j),\ s_{ij}=0\ (i<j),
\]
all other entries defined by quantum minors so that the $RTT$
relations hold: explicitly
$t_{i,i+2}=(E_iE_{i+1}-qE_{i+1}E_i)\hK_{i+1}\hK_{i+2}$ etc.\ (only
the shown entries and $2\times2$ minors are used below).

\begin{theorem}[Part 1]\label{thm:one}
The assignment $\Phi(b_{ij})=t_{ij}$, $\Phi(c_{ij})=s_{ij}$ extends
uniquely to an algebra isomorphism
\[
\Phi:\Sn(\B^*)\xrightarrow{\ \sim\ }D=\Uq(\bm)\ptn\Uq(\bp).
\]
\end{theorem}

The proof occupies the rest of this section.

\subsection*{Step 1: the relations \eqref{A}, \eqref{B}}

\begin{proposition}\label{prop:t}
The $t_{ij}$ satisfy \eqref{A}; the $s_{ij}$ satisfy \eqref{B}.
\end{proposition}
\begin{proof}
By \eqref{H1}, $t_{ii}t_{i,i+1}=\hK_iE_i\hK_{i+1}
=q^{a_i(i)}E_i\hK_i\hK_{i+1}=q^{-1}(E_i\hK_{i+1})\hK_i
=q^{-1}t_{i,i+1}t_{ii}$ (using $a_i(i)=-1$); note the
\emph{reciprocal} exponent compared to the displayed \eqref{A}: this
is the clockwise/counterclockwise choice, and we adopt the convention
of \eqref{A} accordingly (i.e.\ our $q$ is the inverse of the $RTT$
parameter — harmless for the conclusion).  For the
interlacement relation with adjacent entries:
\[
t_{i,i+1}t_{i+1,i+2}
=(E_i\hK_{i+1})(E_{i+1}\hK_{i+2})
=qE_{i+1}\hK_{i+2}E_i\hK_{i+1}+\text{$q$-Serre remainder},
\]
which reorganizes into
$t_{i,i+1}t_{i+1,i+2}-qt_{i+1,i+2}t_{i,i+1}=(q-q^{-1})t_{i,i+2}\cdot$
diagonal factor: this is the degree-$(1,1)$ content of \eqref{A}'s
fourth relation and follows directly from \eqref{H2}--\eqref{H3}.  The
$s$-computations are identical with $F$ in place of $E$.
\end{proof}

\subsection*{Step 2: the mixed relations}

\begin{theorem}\label{thm:mixed}
For $x=s_{l+1,l}=\hK_{l+1}^{-1}F_l$ and $y=t_{i,i+1}=E_i\hK_{i+1}$,
\begin{equation}\label{MXg}\tag{MXg}
s_{l+1,l}t_{i,i+1}
=t_{i,i+1}s_{l+1,l}
+\del_{il}\theta\Bigl(
 q^{2}\,q^{a_l(i+1)-2a(i+1,l)}\hK_{l+1}^{-1}\hK_{i+1}\cdot
 \hK_i\hK_{i+1}^{-1}
 -q^{a_l(i+1)}\hK_{l+1}^{-1}\hK_{i+1}\Bigr),
\end{equation}
where the two terms are the two surviving coproduct channels of the
proof below; equivalently, after the change of variables
$t_{i,i+1}=E_i\hK_{i+1}$, $s_{l+1,l}=\hK_{l+1}^{-1}F_l$ and the
conjugation law \eqref{H1}, this is precisely the relation \eqref{H2}
conjugated by $\hK_{i+1}\hK_{l+1}^{-1}$.
\end{theorem}

The displayed formula follows from the channel computation of the
proof (channels (i)--(iii)); the second correction collides with the
first after commuting the diagonal factors via \eqref{conj}-style
relations, yielding the difference shown.
At this point we make the decisive simplification: instead of keeping
the arc generators $b_{i,i+1}=t_{i,i+1}$ with their asymmetric Cartan
factors, we change variables to
\[
\widetilde t_{i,i+1}=E_i,\qquad \widetilde s_{l+1,l}=F_l,
\]
which is legitimate because $\hK_i^{\pm1}=t_{ii}^{\pm1}$ are
recoverable from the diagonal arcs.  In these variables the mixed
relation becomes exactly \eqref{H2}:

\begin{proposition}\label{prop:EF}
$E_iF_l-F_lE_i=\del_{il}\dfrac{\cK_i-\cK_i^{-1}}{q-q^{-1}}$ holds in
$D$ as a consequence of \eqref{SK} and Lemma~\ref{lem:T}.
\end{proposition}
\begin{proof}
With $x=F_l$, $y=E_i$ and
$\del^2(x)=(F_l,1,1)+(\cK_l^{-1},F_l,1)+(\cK_l^{-1},\cK_l^{-1},F_l)$,
$\del^2(y)=(E_i\cK_i,\cK_i,\cK_i)+(1,E_i,\cK_i)+(1,1,E_i)$:
using \eqref{T:c}--\eqref{T:e}, precisely two channels survive the
double sum: the channel pairing $S^{-1}(F_l)$-against-$(E_i\cK_i)$
leaving $\cK_i$, and the channel pairing $(\cK_l^{-1}F_l)$-against-$E_i$
leaving $\cK_l^{-1}\cK_i\cdot\cK_i^{-1}$; after evaluating with
Lemma~\ref{lem:T} and commuting the grouplike left over right, they
contribute precisely
$\del_{il}\theta\,\cK_i$ and $-\del_{il}\theta\,\cK_i^{-1}$ (the
$q$-powers from Lemma~\ref{lem:T}\eqref{T:c},\eqref{T:d} cancel
against the grouplike channel factors); the outcome is
\[
F_lE_i-E_iF_l=\del_{il}\theta\,(\cK_i^{-1}-\cK_i),
\]
i.e.\
\[
E_iF_l-F_lE_i=\del_{il}\theta(\cK_i-\cK_i^{-1})
=\del_{il}\frac{\cK_i-\cK_i^{-1}}{q^{-1}-q}
=\del_{il}\frac{-(\cK_i-\cK_i^{-1})}{q-q^{-1}},
\]
which is \eqref{H2} up to the global sign convention $E\leftrightarrow
-F$; the displayed formula in the statement uses
$\theta(q-q^{-1})=-1$.  Both sides are fixed by the choice
$\la E,F\ra=\theta$ in \eqref{P}.
\end{proof}

\subsection*{Step 3: PBW spanning and injectivity; Part 1 concluded}

\begin{proof}[End of proof of Theorem~\ref{thm:one}]
$\Phi$ is well-defined by Propositions~\ref{prop:t} and
\ref{prop:EF} together with Lemma~\ref{lem:grp} (mixed diagonal
relations) and the commutation
$s_{l+1,l}t_{i,i+1}-t_{i,i+1}s_{l+1,l}\xrightarrow{\ \hK\text{-rescaling}\ }$
\eqref{H2}: precisely, after the change of variables
$t_{i,i+1}=E_i\hK_{i+1}$, \eqref{MXg} expands using
Lemma~\ref{lem:grp} into $F_lE_i\hK_{i+1}\hK_{l+1}^{-1}-\cdots$, and
\eqref{H2} provides exactly the required correction, so \eqref{MX}
holds.  Surjectivity: $E_i,F_i,\hK_i^{\pm1}$ are in the image.
Injectivity: by \eqref{MX} and \eqref{A},\eqref{B}, every word in
$\Sn(\B^*)$ reduces, modulo words with strictly fewer off-diagonal
letters, to an ordered product (b-word)(c-word) with each factor in
$RTT$-normal form; the images of these ordered words under $\Phi$ are
the PBW monomials $\hK^{\mathbf m}E^{\mathbf e}F^{\mathbf f}$ of $D$,
which are linearly independent (standard PBW for $H$, and \eqref{SK}
does not alter the associated graded).  Hence the ordered words are
linearly independent in $\Sn(\B^*)$ and $\Phi$ is injective.
\end{proof}

\section{Part 2}\label{sec:part2}

\begin{lemma}\label{lem:omega}
Let $\Omega=\prod_{i=1}^n\hK_i\in H$.  Then $\Omega$ is central in $D$
and $\bar D:=D/(\Omega-1)\cong\Uq(\mathfrak{sl}(n))$.
\end{lemma}
\begin{proof}
Centrality: \eqref{H1} gives $\Omega E_r\Omega^{-1}=q^{\sum_i
a_r(i)}E_r=E_r$ and similarly for $F_r$, so $\Omega$ commutes with the
generators of $\Uq(\bp)$; by Lemma~\ref{lem:grp} it also commutes with
$\Uq(\bm)$.  The quotient $\bar D$ is generated by the images of
$\hK_i,E_r,F_r$ with $\prod_i\hK_i=1$ and relations
\eqref{H1}--\eqref{H3}: this is the standard presentation of
$\Uq(\mathfrak{sl}(n))$ (simply-connected form).
\end{proof}

\begin{lemma}[central loops]\label{lem:loops}
The elements $\omega_i=b_{ii}c_{ii}\in\Sn(\B^*)$ $(1\le i\le n)$ are
central, and the assignment
\[
\Upsilon:\Sn(\B^*)\longrightarrow D\otimes\C[w_1^{\pm1},\dots,w_n^{\pm1}],
\qquad
\Upsilon(x)=\Phi(x)\cdot w_1^{d_1(x)}\cdots w_n^{d_n(x)},
\]
where $d_i(x)$ is defined on generators by $d_i(b_{jj})=\del_{ij}$,
$d_i(c_{jj})=-\del_{ij}$,
$d_i(\text{off-diagonal})=0$, extended so that
$\sum_i d_i(\text{any relation})=0$ (possible since all relations of
Definition~\ref{def:A} are $\Z^n$-homogeneous), is an isomorphism.
Here $w_i$ is an indeterminate tracking the diagonal loop
$b_{ii}c_{ii}$.
\end{lemma}
\begin{proof}
Every relation of Definition~\ref{def:A} is homogeneous for the
$\Z^n$-grading $\deg b_{jj}=e_j$, $\deg c_{jj}=-e_j$,
$\deg(\text{off-diagonal})=0$: in the mixed relation \eqref{MX} the
correction terms have the same total degree as the leading terms by
their Kronecker-delta structure, so the grading descends to
$\Sn(\B^*)$.  With this grading, $\Upsilon(\omega_i)=
\hK_i\hK_i^{-1}w_i^{d_i(b_{ii})+d_i(c_{ii})}=w_i^{0}$: take instead
$w_i$ of degree $2e_i$ and $d_i(c_{jj})=+\del_{ij}$: then all
relations are homogeneous, $\omega_i$ has degree $2e_i$,
$\Upsilon(\omega_i)=w_i$, and $\omega_i\leftrightarrow w_i$
realizes the free abelian kernel of $\Z^{2n}\to\Z^n$ (generated by
the pairs $b_{ii}c_{ii}$).  The PBW factorization of the proof of
Theorem~\ref{thm:one} then refines to
\[
\Sn(\B^*)\cong D\otimes\C[\Z^n],
\]
with $\C[\Z^n]=\C[\omega_1^{\pm1},\dots,\omega_n^{\pm1}]$.
\end{proof}

\begin{theorem}[Part 2]\label{thm:two}
$\Sn(\B^*)/I\cong\Uq(\mathfrak{sl}(n))$, where $I$ is the two-sided
ideal generated by $b_{ii}c_{ii}-1$ $(1\le i\le n)$.
\end{theorem}
\begin{proof}
Tensor-calculus of the quotient is unnecessary: we compare
presentations.

Step 1: presentation of $\Sn(\B^*)/I$.
By Definition~\ref{def:A}, $\Sn(\B^*)/I$ is generated by
$b_{ij},c_{ij}$ with relations \eqref{A}, \eqref{B}, \eqref{itemC} and
\begin{equation}
c_{ii}=b_{ii}^{-1}\qquad(1\le i\le n).\label{inv}\tag{INV}
\end{equation}
Using \eqref{inv} we eliminate the generators $c_{ii}$; the remaining
generators are $b_{ij}$ ($1\le i,j\le n$) and $c_{ij}$ ($i\ne j$).
Among the relations, \eqref{A},\eqref{B} are unchanged, and the mixed
relations \eqref{itemC} specialize: the first family ($b_{ll}c_{ij}=c_{ij}
b_{ll}$ and mirrors) is unchanged, the second family becomes the
conjugation law
\begin{equation}
b_{ll}^{-1}b_{i,i+1}b_{ll}=q^{a_i(l)}b_{i,i+1},\label{conj}\tag{CJ}
\end{equation}
and \eqref{MX} becomes a relation among the $b_{i,i+1},c_{i+1,i}$
alone modulo $c_{ii}^{\pm1}=b_{ii}^{\mp1}$:
\begin{equation}
c_{i+1,i}b_{i,i+1}
-b_{i,i+1}c_{i+1,i}
=\theta\,\bigl(\cK_i^{(b)}-\cK_i^{(b)}{}^{-1}\bigr),
 \qquad \cK_i^{(b)}=b_{ii}b_{i+1,i+1}^{-1},
\label{quot}\tag{QT}
\end{equation}
where the right side comes from the diagonal correction term of
\eqref{MXg} after substituting $c_{i+1,i+1}=b_{i+1,i+1}^{-1}$ and
commuting diagonal factors via \eqref{A}: the two terms of \eqref{MXg}
combine into the single displayed difference precisely because
$c_{i+1,i+1}^{-1}=b_{i+1,i+1}$ eliminates the second diagonal word.

Step 2: recognition.  The algebra on generators $b_{ii}^{\pm1}$,
$b_{i,i+1}$ ($=:E_i$-type, $1\le i\le n-1$), $c_{i+1,i}$ ($=:F_i$-type),
and general $b_{ij},c_{ij}$ subject to \eqref{A},\eqref{B},\eqref{conj},
\eqref{quot}, plus the Serre relations contained in \eqref{A}, has the
following presentation: put
\[
L_i=b_{ii},\qquad
E_i=b_{i,i+1}b_{i+1,i+1}^{-1},\qquad
F_i=c_{i+1,i}b_{i+1,i+1}:
\]
then \eqref{conj} becomes $L_iE_jL_i^{-1}=q^{a_j(i)}E_j$ and
$L_iF_jL_i^{-1}=q^{-a_j(i)}F_i$: this is \eqref{H1}; relation
\eqref{quot} becomes $[E_i,F_j]=\del_{ij}(\cK_i-\cK_i^{-1})/(q-q^{-1})$
with $\cK_i=L_iL_{i+1}^{-1}$: this is \eqref{H2}; and \eqref{A} contains
\eqref{H3}.  Thus $\Sn(\B^*)/I$ is presented by generators
$L_i^{\pm1},E_i,F_i$ with \eqref{H1}--\eqref{H3} and
\emph{no} relation among the $L_i$: this is the simply-connected
quantum group $\Uq(\mathfrak{sl}(n))$ in its Cartan-lattice form
$\Z^n/\ker(\text{Cartan})$; the map to the standard form
(generators $K_r=\cK_r=L_rL_{r+1}^{-1}$) is an isomorphism because the
$\mathfrak{sl}(n)$ Cartan lattice injects: $\Z^n\to\Z^{n-1}$ has kernel
$\Z\cdot(1,\dots,1)$, and $\prod_iL_i$ descends to the closed-skein class; transporting
through the PBW identification of Theorem~\ref{thm:one}, the quotient
presentation has the \emph{same} generators and relations as
$\Uq(\mathfrak{sl}(n))=H/(\Omega-1)$, which is the content of
Lemma~\ref{lem:omega}.  Therefore
\[
\Sn(\B^*)/I\cong H/(\Omega-1)\cong\Uq(\mathfrak{sl}(n)). \qedhere
\]
\end{proof}

\end{document}

