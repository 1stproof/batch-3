def cp1(s):
    if s[0]=='g': return [((s,),(s,))]
    if s[0]=='E': return [((s,),()),(( ('g','p',alphaE(s[1])),),(s,))]
    return [((s,),(('g','m',alphaE(s[1])),)),((),(s,))]   # F: D F = F x cK"'^{-1} + 1 x F ; cK''^{-1} = K''^{-kappa}... careful
def cp2(w):
    chans=[((),())]
    for s in w:
        chans=[(a+x,b+y) for (a,b) in chans for (x,y) in cp1(s)]
    return chans
def cp3(w):
    out=[]
