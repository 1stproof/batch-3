"""Clean exact pairing engine, final conventions (round 1).

Words in B^-(m) and B^+(p) as tuples of letters:
  ('g', side, w) grouplike K^w, w integer tuple weight;
  ('F', s) letter in m (s 0-based => F_{s+1});  ('E', r) letter in p.
Coproducts on flat words = shuffle-free 2-slot channels with shuffled-then-flat
concatenation (slots concatenated in word order, coproduct of product = product of
coproducts slotwise):
  D(g) = (g,g);  D(E) = (E,1)+(cK_p,E) with cK_p = K^{alpha_r (p)};
  D(F) = (F,K^{-alpha_s (m)})+(1,F).
PA: <u, yz> = sum_{D(u)} <u1,z><u2,y>;   <uv,z> = sum_{D(z)} <u,z1><v,z2>.
Base values: <K^u(m),K^v(p)> = q^{u.v}; <F_s,E_r> = delta_rs theta;
             <grouplike, charged letter> = 0 = <charged letter, grouplike>;
             <1,y>=eps(y), <u,1>=eps(u); eps(letter)=0, eps(g)=1.
S^2-letter channels are just the 3-slot versions when needed by vtest, not here.
"""
import sys, functools
from fractions import Fraction as Fr
sys.path.insert(0, '/work/first-proof-humanize-tdgou2bu/002-prob-003/scratch')
from rat import RF

D = 12  # denominator; q = t^12
def QE(x):
    x = Fr(x); e = D*x
    assert e.denominator == 1, x
    return RF.c(1, int(e))
TH = QE(0)/(QE(-1) - QE(1))
ZERO = RF.c(0); ONE = RF.c(1)
N = 2

def alpha(r):
    return tuple(-1 if j == r else (1 if j == r+1 else 0) for j in range(N))

def adot(u, v):
    return Fr(sum(u)*sum(v), N) - sum(a*b for a, b in zip(u, v))

def d1(s):
    """2-slot coproduct channels of one flat letter."""
    if s[0] == 'g':
        return [(s, s)]
    if s[0] == 'E':
        K = ('g', 'p', alpha(s[1]))
        return [(s, '1'), (K, s)]
    # F
    Ki = ('g', 'm', tuple(-x for x in alpha(s[1])))
    return [(s, Ki), ('1', s)]

def d2slots(word):
    """2-slot channels of a flat word: slotwise d1, concatenated; '1' dropped."""
    chans = [((), ())]
    for s in word:
        chans = [(w1 + (() if b1 == '1' else (b1,)),
                  w2 + (() if b2 == '1' else (b2,)))
                 for (w1, w2) in chans for (b1, b2) in d1(s)]
    return chans

def isG(w):
    return all(s[0] == 'g' for s in w)

def totW(w):
    u = [0]*N
    for s in w:
        u = [a+b for a, b in zip(u, s[2])]
    return tuple(u)

@functools.lru_cache(maxsize=None)
def pair(u, v):
    """<u, v>, u m-word, v p-word, flat tuples."""
    if not u:
        return ONE if isG(v) else ZERO
    if not v:
        return ONE if isG(u) else ZERO
    if len(u) > 1:
        a, rest = u[0], u[1:]
        out = ZERO
        for (v1, v2) in d2slots(v):
            p1 = pair((a,), v1)
            if p1.iszero(): continue
            out += p1 * pair(rest, v2)
        return out
    a = u[0]
    if a[0] == 'g':
        if not isG(v):
            return ZERO
        return QE(adot(a[2], totW(v)))
    # single charged letter a (side m: an F) vs right word v
    if len(v) == 1:
        z = v[0]
        # base axioms from (P): charged-vs-grouplike = 0; <F_s,E_r> = delta TH
        if z[0] == 'g':
            return ZERO
        if a[0] == 'F' and z[0] == 'E':
            return TH if a[1] == z[1] else ZERO
        return ZERO
    # single charged letter a vs right word v: PA on the RIGHT factor:
    # <a, yz> = sum_{D(a)} <a_1, z> <a_2, y>, split off last letter z.
    z, y = v[-1], v[:-1]
    out = ZERO
    for (b1, b2) in d1(a):
        b1 = () if b1 == '1' else (b1,)
        b2 = () if b2 == '1' else (b2,)
        p1 = pair(b1, (z,))
        if p1.iszero(): continue
        out += p1 * pair(b2, y)
    return out

if __name__ == '__main__':
    ok = True
    def chk(name, got, want):
