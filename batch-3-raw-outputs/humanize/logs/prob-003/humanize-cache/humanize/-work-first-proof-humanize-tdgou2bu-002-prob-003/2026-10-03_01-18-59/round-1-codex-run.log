"""Vector-space model of D. All grouplikes stored as weight tuples; the model reduces
any adjacent same-side grouplike merge immediately, tracking q-scalars from cross rules.
Cross rules (solution.tex conventions):
  m^u E_r = q^{ar.u} E_r m^u ; F_s p^u = q^{as.u} p^u F_s ; m p = p m ;
  F_s E_r = E_r F_s + delta_rs TH(cKp_r - cKm_r^-1).
Same-side: K^u X_r K^-u with H1 gives X K^u = q^{?}: we implement via the absolute
rules E_r p^u = q^{ar.u} p^u E_r and F_s m^u = q^{as.u} m^u F_s (consistent with H1).
"""
from fractions import Fraction as Fr
import sys; sys.path.insert(0,'.')
from rat import RF

D = 12
def QE(x):
    x = Fr(x); e = D*x
    assert e.denominator == 1, x
    return RF.c(1, int(e))
TH = QE(0)/(QE(-1) - QE(1))

def isG(s): return s[0] in ('p','m')
def side(s): return s[0]

class V:
    def __init__(self, N):
        self.N = N
    def alpha(self, r):
