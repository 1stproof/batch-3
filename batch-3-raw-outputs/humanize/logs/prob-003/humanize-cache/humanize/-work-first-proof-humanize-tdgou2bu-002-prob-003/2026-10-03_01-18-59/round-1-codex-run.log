        else: opts=[((('g','m',alphaE(s[1])),s),RF.c(-1))]
        for (w1,c1) in res:
            for (w2,c2) in opts: nxt.append((w1+w2,c1*c2))
        res=nxt
    return res
def cross(x,y):
    \"\"\"SK: m-word x, p-word y -> dict of normalized m+p words\"\"\"
    out={}
