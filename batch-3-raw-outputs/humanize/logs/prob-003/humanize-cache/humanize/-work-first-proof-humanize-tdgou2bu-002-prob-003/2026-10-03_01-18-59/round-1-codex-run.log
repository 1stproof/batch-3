"""Rational functions in t (t^4 = q), exact arithmetic."""
from fractions import Fraction as Fr
from collections import defaultdict

class RF:
    __slots__=('n','d')  # num, den: dict exp->Fraction (Laurent polys), den normalized monic-ish
    def __init__(self, n=None, d=None):
        self.n = {e:Fr(c) for e,c in (n or {}).items() if Fr(c)!=0}
        self.d = {e:Fr(c) for e,c in (d or {0:Fr(1)}).items() if Fr(c)!=0}
        assert self.d, "zero denominator"
    @staticmethod
    def c(val, e=0):  # constant * t^e
        if val==0: return RF({},{0:Fr(1)})
        return RF({e:Fr(val)},{0:Fr(1)})
    def __add__(a,b):
        n=defaultdict(Fr)
        for e,c in a.n.items():
            for e2,c2 in b.d.items(): n[e+e2]+=c*c2
        for e,c in b.n.items():
            for e2,c2 in a.d.items(): n[e+e2]+=c*c2
        d=defaultdict(Fr)
        for e,c in a.d.items():
            for e2,c2 in b.d.items(): d[e+e2]+=c*c2
        return RF(dict(n),dict(d))
    __radd__=__add__
    def __neg__(a): return RF({e:-c for e,c in a.n.items()}, a.d)
    def __sub__(a,b): return a+(-b)
    def __mul__(a,b):
        n=defaultdict(Fr)
        for e,c in a.n.items():
            for e2,c2 in b.n.items(): n[e+e2]+=c*c2
        d=defaultdict(Fr)
        for e,c in a.d.items():
            for e2,c2 in b.d.items(): d[e+e2]+=c*c2
        return RF(dict(n),dict(d))
    __rmul__=__mul__
    def inv(a):
        assert a.n, "div by zero"
        return RF(a.d, a.n)
    def __truediv__(a,b): return a*b.inv()
    def iszero(a): return not a.n
    def eq(a,b): return (a-b).iszero()
    def scale_to(self,target):
        # return c such that self = c*target if proportional else None
        r = self/target
        # r is scalar iff num = c*den
        if not r.n: return Fr(0) if False else None
        es=list(r.n); e0=es[0]
        # require r == c * t^{e0} * den? r is RF; scalar times t^e iff n,d have same support shifted
        # check r.n[e]/r.d[e'] pattern: r should equal C*t^k

