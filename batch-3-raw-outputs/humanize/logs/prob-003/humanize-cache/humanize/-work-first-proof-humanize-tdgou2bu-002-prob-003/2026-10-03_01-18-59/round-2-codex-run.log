class V:
    def __init__(self, N):
        self.N = N
    def al(self, r):                       # -e_r + e_{r+1}
        return tuple(-1 if i == r else (1 if i == r + 1 else 0) for i in range(self.N))
    def av(self, r, u):                    # alpha_r(u) = -u_r + u_{r+1}
        return -u[r] + u[r + 1]
    def mul(self, A, B):
        out = {}
        for wa, ca in A.items():
            for wb, cb in B.items():
                for w, c in self.mul_words(tuple(wa), tuple(wb)).items():
                    out[w] = out.get(w, RF.c(0)) + ca * cb * c
        return {k: v for k, v in out.items() if not v.iszero()}
    def mul_words(self, wa, wb):
        work = {tuple(wa) + tuple(wb): RF.c(1)}
        for _ in range(2000000):
            changed = False
            for w0 in list(work):
                c0 = work[w0]
                if c0.iszero():
                    del work[w0]; continue
                wl = list(w0)
                hit = None; i = None
                for k in range(len(wl) - 1):
                    sw = self.step(wl[k], wl[k + 1])
                    if sw is not None:
                        i, hit = k, sw; break
                if hit is None: continue
                del work[w0]
