                    nw = tuple(wl[:i]) + tuple(sub) + tuple(wl[i + 2:])
                    work[nw] = work.get(nw, ZERO) + c0 * cc
                changed = True
            if not changed: break
        else:
            raise RuntimeError('nontermination')
