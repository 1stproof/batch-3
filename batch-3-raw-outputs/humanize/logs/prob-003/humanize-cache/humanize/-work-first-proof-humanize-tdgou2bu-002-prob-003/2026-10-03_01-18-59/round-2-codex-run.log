# Instead reduce the EXPRESSIONS using only: lem:cross(a),(b),(c) [certified by (SK) at engine level in both worlds],
# internal (H1) both sides, and the RAW (EF) equality E F = F E + delta(-th q"'^{e} cK''^{(m)-1} + th cK''^{(p)})
# where q''^e = q''^{-2} (both worlds give e=-2 as shown: vrf EF battery; my coop engine).
# Reduction to normal form (F-letters, negW, posW, E-letters) with crossing rules:
#   F_s K''^{u(p)} = q''^{+al_s(u)} K''^{u(p)} F_s     [lem:cross(b) as cross relation, certified]
#   E_r K''^{u(m)} = q''^{-al_r(u)} K''^{u(m)} E_r     [lem:cross(a) as cross relation]
#   F_s K''^{u(m)} = q''^{+al_s(u)} K''^{u(m)} F_s     [internal neg (H1): K''^{-u}F=q''^{+al(-u)}.. -> consistent]
#   E_r K''^{u(p)} = q''^{-al_r(u)} K''^{u(p)} E_r     [internal pos (H1)]
#   grouplikes all commute (cross-side (c))
import itertools
from fractions import Fraction as Fr
class RF:
    def __init__(s,d=None): s.d=d or {}
    @staticmethod
    def c(a,e=0): return RF({e:Fr(a)}) if a else RF()
    def __add__(s,o):
        d=dict(s.d)
        for k,v in o.d.items(): d[k]=d.get(k,Fr(0))+v
        return RF({k:v for k,v in d.items() if v})
    __radd__=__add__
    def __sub__(s,o): return s+o*RF.c(-1)
    def __mul__(s,o):
        d={}
        for a,va in s.d.items():
            for b,vb in o.d.items(): d[a+b]=d.get(a+b,Fr(0))+va*vb
        return RF({k:v for k,v in d.items() if v})
    __rmul__=__mul__
    def iszero(s): return not s.d
    def __repr__(s): return repr(s.d)
Dv=12
def QE(x):
    x=Fr(x); e=Dv*x; assert e.denominator==1; return RF.c(1,int(e))
TH=RF({-12:Fr(1),12:Fr(-1)})

def reduce_D(word, n, e_exp=-2):
    # word: list of tokens: ('"'E',r),('F',s),('m',u),('p',u). Reduce to dict[(Fs, mW, pW, Es)]->scalar
    # 1) replace every adjacent ('F',s),('E',r) via raw-EF (introduces pure-torus terms), repeat until no FE pattern.
    # 2) move all grouplikes to the rear/middle with the crossing rules above.
    # iterate to fixpoint.
    def step(w):
        for i in range(len(w)-1):
            a,b=w[i],w[i+1]
            if a[0]=='F' and b[0]=='E':
                r,s2=b[1],a[1]
                al=tuple(-1 if k==s2 else (1 if k==s2+1 else 0) for k in range(n))
                # E F variant word
                v1=w[:i]+[b,a]+w[i+2:]
                out={tuple(v1):RF.c(1)}
                if r==s2:
                    # -th q"'^{e} cK''^{(m)-1}: cK''^{(m)-1} weight +alpha(s2)
                    v2=w[:i]+[('"'m',al)]+w[i+2:]
                    out.setdefault(tuple(v2),RF())
                    out[tuple(v2)]=out[tuple(v2)]+(RF.c(0)-(TH*QE(e_exp)))
                    # +th cK_r"'^{(p)}: weight -alpha(r)
                    v3=w[:i]+[('"'p',tuple(-x for x in al))]+w[i+2:]
                    out.setdefault(tuple(v3),RF())
                    out[tuple(v3)]=out[tuple(v3)]+TH
                return out  # one replacement per scan
        return None
    expr={tuple(word):RF.c(1)}
    def closure_variables(exp):
        changed=True
        while changed:
            changed=False
            newexp={}
            for w,sc in exp.items():
                res=step(list(w))
                if res is None:
                    newexp[w]=newexp.get(w,RF())+sc
                else:
                    changed=True
                    for w2,c2 in res.items():
                        newexp[w2]=newexp.get(w2,RF())+sc*c2
            exp=newexp
        return exp
    expr=closure_variables(expr)
    # now move grouplikes to canonical (F's | m | p | E's): cross grouplike LEFT-to-back across letters LEFT of it? Rear=right end,
    # but E's must stay RIGHTMOST. Canonical: F's, m, p, E's: move grouplikes left past E's? No: order F < g < E means grouplike
    # crosses E from LEFT: g E -> E g at cost: K"'^{u(p)} E_r = q''^{+al_r(u)} E_r K''^{u(p)}; K''^{u(m)} E_r = q''^{+al_r(u)} E_r K''^{u(m)} (cross (a): K''^{(m)} E = q''^{+al} E K''^{(m)}).
    # grouplike crossing across F from right? F'"'s are LEFT of grouplikes: pattern (g, F) with g left of F -> move F left? handle (g,F)->F g:
    #   K"'^{u(p)} F = q''^{-al} F K''^{u(p)} ; K''^{u(m)} F = q''^{-al} F K''^{u(m)} (internal neg conjug K F K''^-1 = q''^{-al}).
    def aval(r,u): return -u[r]+u[r+1]
    def sort_key_norm(w):
        # bubble sort with tokens order: F(0) < m(1) < p(2) < E(3); F'"'s and E's keep relative order; grouplikes merge by class.
        w=list(w); sc=RF.c(1)
        def rk(t): return {'F':0,'m':1,'p':2,'E':3}[t[0]]
        changed=True
        while changed:
            changed=False
            for i in range(len(w)-1):
                a,b=w[i],w[i+1]
                if rk(a)>rk(b):
                    if a[0] in 'mp' and b[0]=='F':
                        sc=sc*QE(-aval(b[1],a[1]))
                    elif a[0] in 'mp' and b[0]=='E':
                        sc=sc*QE(+aval(b[1],a[1]))
                    else:
                        raise Exception('unexpected swap %s %s'%(a,b))
                    w[i],w[i+1]=b,a; changed=True
        # merge grouplikes by class
        Fs=tuple(x for x in w if x[0]=='F'); Es=tuple(x for x in w if x[0]=='E')
        mw=(0,)*n; pw=(0,)*n
        for x in w:
            if x[0]=='m': mw=tuple(p+q for p,q in zip(mw,x[1]))
            if x[0]=='p': pw=tuple(p+q for p,q in zip(pw,x[1]))
        return sc,(Fs,mw,pw,Es)
    out={}
    for w,sc0 in expr.items():
        sc,key=sort_key_norm(w)
        out[key]=out.get(key,RF())+sc0*sc
    return {k:v for k,v in out.items() if not v.iszero()}

def al(r,n): return tuple(-1 if k==r else (1 if k==r+1 else 0) for k in range(n))
def show(d): return {k:v.d for k,v in d.items()}
for n in (2,3):
    for r in range(n-1):
        s=r
        a=al(s,n)
        # LHS: (raw EF displayed) * cK_s"'^{(m)}: word [E,F] then m(-a): represents (E_r F_s)*cK''^{(m)}
        lhsW=[('"'E',r),('F',s),('m',tuple(-x for x in a))]
        lhs=reduce_D(lhsW,n)
        # via rawEF applied INSIDE lhs: (FE - th q"'^e cK''^{(m)-1} + th cK''^{(p)}) cK''^{(m)}:
        L2=[('"'F',s),('E',r),('m',tuple(-x for x in a))]
        lhs_raw=reduce_D(L2,n)
        # add the two theta terms manually in word form: -th q"'^e cK''^{-1} cK = -th q''^e (torus cancels to identity)
