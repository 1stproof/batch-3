from fractions import Fraction as Fr
class RF:
    def __init__(s,d=None): s.d=d or {}
    @staticmethod
    def c(a,e=0): return RF({e:Fr(a)}) if a else RF()
    def __add__(s,o):
        d=dict(s.d)
        for k,v in o.d.items(): d[k]=d.get(k,Fr(0))+v
        return RF({k:v for k,v in d.items() if v})
    __radd__=__add__
    def __sub__(s,o): return s+o*RF.c(-1)
    def __mul__(s,o):
        d={}
        for a,va in s.d.items():
            for b,vb in o.d.items(): d[a+b]=d.get(a+b,Fr(0))+va*vb
        return RF({k:v for k,v in d.items() if v})
    __rmul__=__mul__
    def __truediv__(s,o):
        (e,v),=o.d.items(); return RF({k-e:val/v for k,val in s.d.items()})
    def __neg__(s): return s*RF.c(-1)
    def iszero(s): return not s.d
    def __repr__(s): return repr({ 't"'^%d'"'%k:str(v) for k,v in s.d.items()})
Dv=12
def QE(x):
    x=Fr(x); e=Dv*x; assert e.denominator==1; return RF.c(1,int(e))
TH=RF({-12:Fr(1),12:Fr(-1)})

class E2:
    def __init__(s,n,mode):
        s.n=n; s.mode=mode; s.cache={}
    def adot(s,u,v): return Fr(sum(u)*sum(v),s.n)-sum(a*b for a,b in zip(u,v))
    def eps(s,w): return RF.c(1) if all(x[0]=='g' for x in w) else RF()
    def d1(s,x):
        if x[0]=='g': return [(x,x)]
        if x[0]=='E':
            r=x[1]; a=tuple(-1 if i==r else (1 if i==r+1 else 0) for i in range(s.n))
            return [(x,None),(('g',tuple(-t for t in a)),x)]
        r=x[1]; a=tuple(-1 if i==r else (1 if i==r+1 else 0) for i in range(s.n))
        return [(x,('g',a)),(None,x)]
    def d2w(s,w):
        chans=[((),())]
        for x in w:
            new=[]
            for ch in chans:
                for (a,b) in s.d1(x):
                    new.append((ch[0]+((a,) if a else ()), ch[1]+((b,) if b else ())))
            chans=new
        return chans
    def P(s,u,v):
        key=(u,v)
        if key in s.cache: return s.cache[key]
        r=s._P(u,v); s.cache[key]=r; return r
    def _P(s,u,v):
        if not u: return s.eps(v)
        if not v: return s.eps(u)
        if len(u)==1 and len(v)==1:
            x,y=u[0],v[0]
            if x[0]=='g' and y[0]=='g': return QE(s.adot(x[1],y[1]))
            if x[0]=='F' and y[0]=='E': return TH if x[1]==y[1] else RF()
            if x[0]=='E' and y[0]=='F': return TH if x[1]==y[1] else RF()
            return RF()
        if len(v)>=2:
            y,z=v[:1],v[1:]
            tot=RF()
            for (u1,u2) in s.d2w(u):
                tot=tot+s.P(u1,y)*s.P(u2,z)
            return tot
        else:
            a,b=u[:1],u[1:]
            if s.mode=='straight':
                tot=RF()
                for (z1,z2) in s.d2w(v):
                    tot=tot+s.P(a,z1)*s.P(b,z2)
                return tot
            else:
                tot=RF()
                for (z1,z2) in s.d2w(v):
                    tot=tot+s.P(a,z2)*s.P(b,z1)
                return tot

