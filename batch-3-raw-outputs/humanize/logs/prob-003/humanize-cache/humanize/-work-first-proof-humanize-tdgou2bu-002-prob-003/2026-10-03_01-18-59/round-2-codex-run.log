        chk(f'n{n} T7 <F,E cK> = q^+2 th', w.pair(F(r), E(r) + K(na)), TH * QE(2))
        sc_sw = w.S_word(E(r))
        tot = ZERO
        for (scl, swd) in sc_sw:
            tot += scl * w.pair(F(r), swd)
        chk(f'n{n} T8 <F,S(E)> = -th', tot, RF.c(0) - TH)
    # placement formula (dagger): <F, K^{v1} E K^{v2}> = th q^{-av(v1)}
    for r in range(n - 1):
