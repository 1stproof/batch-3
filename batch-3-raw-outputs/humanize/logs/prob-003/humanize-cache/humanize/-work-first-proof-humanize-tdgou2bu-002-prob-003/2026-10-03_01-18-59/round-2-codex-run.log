            chk(f'n{n} T4 <F,K^u E{r+1}> = th', w.pair(F(r), K(u) + E(r)), TH)
            chk(f'n{n} T5 <F,E{r+1} K^u> = q^-av th', w.pair(F(r), E(r) + K(u)), QE(-av(r, u)) * TH)
