        return (RF.c(-1), (('g', tuple(-x for x in self.alpha(s[1]))), s))  # -cK F (wt -alpha leading)
    # --- the cross map (SK): y x, y plus-word, x minus-word ---
    def cross(self, y, x):
        out = {}
        for (x1, x2, x3) in self.dslots(x, 3):
            for (y1, y2, y3) in self.dslots(y, 3):
                s1 = ZERO
                for (a, wx) in self.Sinv_word(x1):
                    s1 += a * self.pair(wx, y1)
                if s1.iszero(): continue
                s3 = self.pair(x3, y3)
                if s3.iszero(): continue
                out[(x2, y2)] = out.get((x2, y2), ZERO) + s1 * s3
        return {k: v for k, v in out.items() if not v.iszero()}

# =============================== battery =====================================
def run(n):
    w = Engine(n)
    e = lambda i: tuple(1 if j == i else 0 for j in range(n))
    K = lambda u: (('g', u),)
    E = lambda r: (('E', r, 'p'),)
    F = lambda s: (('F', s, 'm'),)
    av = w.aval
    avw = w.alpha
