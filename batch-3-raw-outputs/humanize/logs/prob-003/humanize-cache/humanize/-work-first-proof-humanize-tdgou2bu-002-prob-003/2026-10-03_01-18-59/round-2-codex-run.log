from fractions import Fraction as Fr
class RF:
    def __init__(s,d=None): s.d=d or {}
    @staticmethod
    def c(a,e=0): return RF({e:Fr(a)}) if a else RF()
    def __add__(s,o):
        d=dict(s.d)
        for k,v in o.d.items(): d[k]=d.get(k,Fr(0))+v
        return RF({k:v for k,v in d.items() if v})
    __radd__=__add__
    def __sub__(s,o): return s+o*RF.c(-1)
    def __mul__(s,o):
        d={}
        for a,va in s.d.items():
            for b,vb in o.d.items(): d[a+b]=d.get(a+b,Fr(0))+va*vb
        return RF({k:v for k,v in d.items() if v})
    __rmul__=__mul__
    def iszero(s): return not s.d
    def __repr__(s): return repr({ 't"'^%d'"'%k:str(v) for k,v in s.d.items()})
Dv=12
def QE(x):
    x=Fr(x); e=Dv*x; assert e.denominator==1; return RF.c(1,int(e))
TH=RF({-12:Fr(1),12:Fr(-1)})

def reduce_D(word, n, e_exp=-2):
    # closure under raw-EF: E F -> F E  (+delta: -th q"'^e cK''^{(m)-1} + th cK''^{(p)})
    def step(w):
        for i in range(len(w)-1):
            a,b=w[i],w[i+1]
            if a[0]=='"'E' and b[0]=='F':
                r,s2=a[1],b[1]
                al=tuple(-1 if k==s2 else (1 if k==s2+1 else 0) for k in range(n))
                out={tuple(w[:i]+[b,a]+w[i+2:]):RF.c(1)}
                if r==s2:
                    v2=tuple(w[:i]+[('m',al)]+w[i+2:])
                    out[v2]=out.get(v2,RF())+(RF.c(0)-(TH*QE(e_exp)))
                    v3=tuple(w[:i]+[('p',tuple(-x for x in al))]+w[i+2:])
                    out[v3]=out.get(v3,RF())+TH
                return out
        return None
    exp={tuple(word):RF.c(1)}
    changed=True
    while changed:
        changed=False
        newexp={}
        for w,sc in exp.items():
            res=step(list(w))
            if res is None: newexp[w]=newexp.get(w,RF())+sc
            else:
                changed=True
                for w2,c2 in res.items(): newexp[w2]=newexp.get(w2,RF())+sc*c2
        exp=newexp
    def aval(r,u): return -u[r]+u[r+1]
    def norm(w):
        w=list(w); sc=RF.c(1)
        def rk(t): return {'F':0,'m':1,'p':2,'E':3}[t[0]]
        ch=True
        while ch:
            ch=False
            for i in range(len(w)-1):
                a,b=w[i],w[i+1]
                if rk(a)>rk(b):
                    if a[0] in 'mp' and b[0]=='F': sc=sc*QE(-aval(b[1],a[1]))
                    elif a[0] in 'mp' and b[0]=='E': sc=sc*QE(+aval(b[1],a[1]))
                    else: raise Exception('bad swap %s %s in %s'%(a,b,w))
                    w[i],w[i+1]=b,a; ch=True
        Fs=tuple(x for x in w if x[0]=='F'); Es=tuple(x for x in w if x[0]=='E')
        mw=(0,)*n; pw=(0,)*n
        for x in w:
            if x[0]=='m': mw=tuple(p+q for p,q in zip(mw,x[1]))
            if x[0]=='p': pw=tuple(p+q for p,q in zip(pw,x[1]))
        return sc,(Fs,mw,pw,Es)
    out={}
    for w,sc0 in exp.items():
        sc,key=norm(w)
        out[key]=out.get(key,RF())+sc0*sc
    return {k:v for k,v in out.items() if not v.iszero()}

def al(r,n): return tuple(-1 if k==r else (1 if k==r+1 else 0) for k in range(n))
def show(d): return {k:{ 't"'^%d'"'%kk:str(vv) for kk,vv in v.d.items()} for k,v in d.items()}
allok=True
for n in (2,3,4):
    for r in range(n-1):
        for s in range(n-1):
            a=al(s,n)
            cKm=('m',tuple(-x for x in a))    # cK_s"'^{(m)} (weight -alpha)
            lhs=reduce_D([('"'E',r),('F',s),cKm],n)
            # via rawEF inside: (F E) cK  - th q"'^-2 (cK''^{-1})(cK) + th cK''^{(p)} cK''^{(m)}
            raw=reduce_D([('"'F',s),('E',r),cKm],n)
            if r==s:
                z=((),(0,)*n,(0,)*n,())
                raw[z]=raw.get(z,RF())+(RF.c(0)-(TH*QE(-2)))
                k2=((),tuple(-x for x in a),tuple(-x for x in a),())
                raw[k2]=raw.get(k2,RF())+TH
            raw={k:v for k,v in raw.items() if not v.iszero()}
            # EF' form*cK: (F E)cK + th cK"'^{(m)}cK''^{(m)} - th cK''^{(p)-1} cK''^{(m)}
            rhs=reduce_D([('"'F',s),('E',r),cKm],n)
            if r==s:
                k3=((),tuple(-2*x for x in a),(0,)*n,())
                rhs[k3]=rhs.get(k3,RF())+TH
                k4=((),tuple(-x for x in a),tuple(+x for x in a),())
                rhs[k4]=rhs.get(k4,RF())+(RF.c(0)-TH)
            rhs={k:v for k,v in rhs.items() if not v.iszero()}
            okA = set(lhs)==set(raw) and all((lhs[k]-raw[k]).iszero() for k in lhs)
            okB = set(lhs)==set(rhs) and all((lhs[k]-rhs[k]).iszero() for k in lhs)
            if not (okA and okB):
                allok=False
                print('n%d r%d s%d: rawEF-self=%s rawEF==EFp=%s'%(n,r,s,okA,okB))
                print(' LHS:',show(lhs)); print(' via rawEF:',show(raw)); print(' via EFp:',show(rhs))
print('ALL OK' if allok else 'MISMATCH FOUND')
