import itertools
from collections import defaultdict

def build_quotient_hf(p, U):
    # U: subgroup of F_p"'^* given as frozenset of residues
    # Cosets
    seen = set(); cosets = []
    for a in range(1, p):
        if a in seen: continue
        c = frozenset((a*u) % p for u in U)
        cosets.append(c); seen |= c
    # elements: 0 plus cosets; represent 0 as integer 0, coset as frozenset
    elems = [0] + cosets
    def neg(e):
        if e == 0: return 0
        return frozenset((-x) % p for x in e)
    def mul(e1, e2):
        if e1 == 0 or e2 == 0: return 0
        a = next(iter(e1)); b = next(iter(e2))
        return frozenset((a*b*u) % p for u in U)
    def hsum2(e1, e2):
        if e1 == 0: return frozenset({e2})
        if e2 == 0: return frozenset({e1})
        out = set()
        for u in U:
            for v in U:
                vals = set()
                a = next(iter(e1)); b = next(iter(e2))
            # hyperadd: aU + bU = { au+bv : u,v in U } classes
        res = set()
        a = e1; b = e2
        adds = set()
        au = next(iter(a)); bu = next(iter(b))
        for u in U:
            for v in U:
                s = (au*u + bu*v) % p
                adds.add(s)
        for s in adds:
            if s == 0:
                res.add(0)
            else:
                res.add(frozenset((s*w) % p for w in U))
        return res
    return elems, neg, mul, hsum2

def hsumN(elems_args, hsum2):
    # n-ary hypersum as set of elements
    S = {elems_args[0]}
    for e in elems_args[1:]:
        T = set()
        for s in S:
            T |= hsum2(s, e)
        S = T
    return S

def check_axioms(elems, neg, mul, hsum2, pairs=None):
    bad = defaultdict(int)
    nze = [e for e in elems if e != 0]
    it = pairs if pairs else nze
    for x in it:
        for y in it:
            if hsum2(x,y) != hsum2(y,x): bad['"'H1comm'] += 1
            if hsum2(x,0) "'!= {x}: bad['"'H1zero'] += 1
            if (0 in hsum2(x,y)) "'!= (y == neg(x)): bad['"'H1neg'] += 1
            for z in it:
                lhs = hsumN([x,y,z], hsum2)
                rhs = set()
                for t in hsum2(y,z):
                    rhs |= hsum2(x,t)
                if lhs "'!= rhs: bad['"'H2'] += 1
                # H4: t in x+y => x in t + (-y)
                for t in hsum2(x, y):
