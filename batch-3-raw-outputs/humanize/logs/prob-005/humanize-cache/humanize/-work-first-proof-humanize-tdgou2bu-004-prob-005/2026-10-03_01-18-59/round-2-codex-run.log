        for y in elems:
            pass
    # H3 distributivity on all
    for a in nze:
        for x in elems:
            for y in elems:
                lhs = {mul(a,s) for s in hsum2(x,y)}
                rhs = hsum2(mul(a,x), mul(a,y))
                if not lhs <= rhs: bad['H3'] += 1
    return dict(bad)

def elem_cube(mul, e, U, p):
    if e == 0: return 0
    a = next(iter(e))
    return frozenset((a*a*a*u) % p if (a*a*a) % p else 0 for u in U) if True else 0

def cube_elem(e, p, U):
    # multiplicative cube of a coset element (=coset of a"'^3)
    if e == 0: return 0
    a = next(iter(e))
    a3 = (a**3) % p
    if a3 == 0: return 0
    return frozenset((a3*u) % p for u in U)

def subgroups(p):
    from math import gcd
    outs = []
    n = p-1
    divs = [d for d in range(1, n+1) if n % d == 0]
    # generator
    g = 2
    while pow(g, n//2, p) == 1: g += 1
    for d in divs:
        # subgroup of order d: generated by g''^(n/d)
        gen = pow(g, n//d, p)
        U = set(); c = 1
        for _ in range(d):
            U.add(c); c = (c*gen) % p
        outs.append(frozenset(U))
    return sorted(set(outs), key=lambda s: (len(s), sorted(s)))

