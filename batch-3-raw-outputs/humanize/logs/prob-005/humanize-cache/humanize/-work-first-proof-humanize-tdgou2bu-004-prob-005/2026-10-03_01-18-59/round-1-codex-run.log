        # class of u: smallest i such that u * g"'^{-i} in U
        for u in range(1, p):
            inv_cache = {}
            for i in range(3):
                if (u * pow(pow(self.g,i,p), p-2, p)) % p in self.U:
                    self.log[u] = i
                    break
        assert len(self.log) == p-1
        self.neg1 = self.log[p-1]

    def cls(self, u):
        if u % self.p == 0: return 0
        return 1 + self.log[u % self.p]   # elements: 0, or 1+i representing g''^i U

    def rep(self, x):
        if x == 0: return 0
        return pow(self.g, x-1, self.p)

    def neg(self, x):
        if x == 0: return 0
        return 1 + (x-1 + self.neg1) % 3

    def mul(self, x, y):
        if x == 0 or y == 0: return 0
        return 1 + ((x-1)+(y-1)) % 3

    def add(self, x, y):
        if x == 0: return frozenset([y])
        if y == 0: return frozenset([x])
        a, b = self.rep(x), self.rep(y)
        out = set()
        for u in self.U:
            for v in self.U:
                out.add(self.cls(a*u + b*v))
        return frozenset(out)

    def elems(self):
        return [0, 1, 2, 3]

def hypersum(H, args):
    S = frozenset([args[0]])
    for a in args[1:]:
        S = frozenset(z for s in S for z in H.add(s, a))
