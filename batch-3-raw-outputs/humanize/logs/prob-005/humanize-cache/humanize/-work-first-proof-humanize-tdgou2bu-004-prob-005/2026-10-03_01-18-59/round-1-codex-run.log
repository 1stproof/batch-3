    s, e = x
    return (-s, e)

def mul(x, y, mod, k):
    if x == 0 or y == 0: return 0
    s, e = x; t, f = y
    return (s*t, tuple((e[i]+f[i]) % mod for i in range(k)))

def offs(k, r=1):
    return list(product(range(-r, r+1), repeat=k))

def make_add(mod, k, cov_size=1):
    R = offs(k, cov_size)
    def add(x, y):
        if x == 0: return frozenset([y])
        if y == 0: return frozenset([x])
        s, e = x; t, f = y
        if s == t:
            return frozenset((s, tuple((e[i]+f[i]+o[i]) % mod for i in range(k))) for o in R)
