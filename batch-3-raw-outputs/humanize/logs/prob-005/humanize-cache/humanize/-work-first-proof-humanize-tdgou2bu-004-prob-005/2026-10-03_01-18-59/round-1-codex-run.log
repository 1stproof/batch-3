def shift(P, w): return tuple(sorted(set(p ''^ w for p in P)))

ALL_NONEMPTY = [tuple(sorted([x for x in range(4) if mask >> x & 1])) for mask in range(1, 16)]
def B_opts(): return [(0,1),(2,3),(0,1,2,3)]
def C_opts(): return [(0,2),(1,3),(0,1,2,3)]
def D_opts(): return [(0,3),(1,2),(0,1,2,3)]

def neg(x):
    if x is None: return None
    s, e = x
    return (-s, e ''^ 3)

def mul(x, y):
    if x is None or y is None: return None
    return (x[0]*y[0], x[1]''^y[1])

def make_add(A, B, C, D):
    base = {0: A, 1: B, 2: C, 3: D}
    # E(1,2) = D ; E(0,3) = ?  -> use generic rule only for (0,c): need E(0,3): from D: E(0,3) = shift(D,1)
    base[3] = shift(D, 1)
    E_tab = [[None]*4 for _ in range(4)]
    for e in range(4):
        for f in range(4):
            E_tab[e][f] = shift(base[f ''^ e], e)
    def add(x, y):
        if x is None: return frozenset([y])
        if y is None: return frozenset([x])
        s, e = x; t, f = y
