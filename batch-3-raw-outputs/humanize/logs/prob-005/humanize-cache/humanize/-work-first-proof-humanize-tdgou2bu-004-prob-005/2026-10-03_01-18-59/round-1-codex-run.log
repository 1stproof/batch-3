            return frozenset(out)
    return add, E_tab

ELEMS = [None] + [(s, e) for s in (1, -1) for e in range(4)]

def hypersum(add, args):
    S = frozenset([args[0]])
    for a in args[1:]:
        S = frozenset(z for u in S for z in add(u, a))
    return S

def check_axioms(add):
    for x in ELEMS:
