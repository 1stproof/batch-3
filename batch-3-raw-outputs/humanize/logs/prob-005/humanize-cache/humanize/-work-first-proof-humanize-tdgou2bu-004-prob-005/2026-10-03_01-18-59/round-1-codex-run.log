def hypersum(add, args):
    S = frozenset([args[0]])
    for a in args[1:]:
        S = frozenset(z for u in S for z in add(u, a))
    return S

ELEMS = [None] + [(s, e) for s in (1, -1) for e in range(4)]

def check_partial(add):
    # returns True if no axiom violation found
    for x in ELEMS:
        for y in ELEMS:
            r = add(x, y)
