def find_gen(p):
    for g in range(2, p):
        seen = set(); x = 1
        for i in range(1, p):
            x = x*g % p
            seen.add(x)
        if len(seen) == p-1:
            return g
    raise ValueError

class QuotHF:
    \"\"\"F_p / U where U = subgroup of cubes (p == 1 mod 3). Elements: 0 or 0..h-1 (exponent of gen mod U).\"\"\"
    def __init__(self, p):
        assert p % 3 == 1
        self.p = p
        self.g = find_gen(p)
        self.U = set()
        x = 1
        for i in range((p-1)//3):
            x = x*pow(self.g,3,p) % p
        # build U directly
        self.U = set(pow(self.g, 3*i, p) for i in range((p-1)//3))
        assert len(self.U) == (p-1)//3
        self.h = 3  # exponent group size
        self.log = {}
        for u in range(1, p):
            for i in range(3):
                if pow(pow(self.g, i, p) * 1, 1, p) in [u]:
