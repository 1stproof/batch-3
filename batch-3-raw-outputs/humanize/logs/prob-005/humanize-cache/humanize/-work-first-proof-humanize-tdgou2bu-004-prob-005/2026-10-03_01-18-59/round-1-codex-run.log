def build_add(E_tab, D_tab):
    def add(x, y):
        if x is None: return frozenset([y])
        if y is None: return frozenset([x])
        s, e = x; t, f = y
        P = E_tab[e][f]
        D = D_tab[e][f]
        if s == t:
