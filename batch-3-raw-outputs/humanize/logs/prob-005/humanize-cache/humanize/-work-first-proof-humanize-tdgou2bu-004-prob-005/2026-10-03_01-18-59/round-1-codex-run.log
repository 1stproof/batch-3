                res.add((1, c)); res.add((-1, c))
            return frozenset(res)
    return add

def elems(mod, k):
    E = [(s, e) for s in (1, -1) for e in product(range(mod), repeat=k)]
    return [0] + E

def hypersum(args, add):
    S = frozenset([args[0]])
    for a in args[1:]:
