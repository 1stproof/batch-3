# Element-level test of the proof chain. Work in F_p directly (elements), with the
# congruence \"think mod S\" tested against the actual hypersum axioms.
# Claim (final lift): if 0 in g ⊞ m ⊞ (-1) with g in a³⊞b³, m in M=(a²b)³⊞(ab²)³,
# then 0 in g ⊞ (ab)³ ⊞ (-1).
def test_lift(p, U):
    p_, cosets, idx, rep = build(p, U)
    hadd = hadd_factory(p, cosets, idx)
    M = lambda A, B: mul(p, cosets, idx, A, B)
    N = lambda A: neg(p, cosets, idx, A)
    C = lambda A: cube(p, cosets, idx, A)
    ONE = idx[1]
    n = len(cosets)
    fails = []
    for a, b in itertools.product(range(n), repeat=2):
        if ONE not in hadd(a, b): continue
        ab = M(a, b)
        a2b = M(M(a,a),b); ab2 = M(a,M(b,b))
        Mset = hsum(hadd, [a2b, a2b, a2b, ab2, ab2, ab2])
        ab3 = hsum(hadd, [ab, ab, ab])
        Gset = hadd(C(a), C(b))
        NONE = None
        for g in Gset:
            for m in Mset:
                # 0 in g ⊞ m ⊞ (-1)  iff -1 = N(ONE) in g⊞m  iff m in N(g) i.e. 0 in g⊞m⊞N(ONE)
                S = hsum(hadd, [g, m, N(ONE)])
                if NONE not in S: continue
                T = hsum(hadd, [g, ab, ab, ab, N(ONE)])
                if NONE not in T:
                    fails.append((a,b,g,m))
    return fails

bad_total = 0
for p in [7, 13, 19, 31, 37]:
    import math
    for d in range(2, p):
        if (p-1) % d: continue
        g0 = primitive_root(p)
        gen = pow(g0, (p-1)//d, p)
        U = frozenset(pow(gen, k, p) for k in range(d))
        if len(U) >= p-1: continue
        f = test_lift(p, sorted(U))
        if f:
            bad_total += 1
            print(\"LIFT FAILS in F_%d / U (|U|=%d): %s\" % (p, len(U), f[:1]))
print(\"lift lemma tested: failures =\", bad_total)
EOF
