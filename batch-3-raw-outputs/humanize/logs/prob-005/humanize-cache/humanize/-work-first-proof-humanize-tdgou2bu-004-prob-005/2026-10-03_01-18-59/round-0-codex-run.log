# The CLEANEST true statement will survive here.
import itertools, math

def isprime(n):
    return n > 1 and all(n % d for d in range(2, int(n**0.5)+1))

def primitive_root(p):
    for g in range(2, p):
        if len(set(pow(g,k,p) for k in range(1,p))) == p-1: return g

def build(p, U):
    U = set(u % p for u in U)
    cosets, seen = [], set()
    for a in range(1, p):
        if a in seen: continue
        c = frozenset((a*u) % p for u in U)
        seen |= c; cosets.append(c)
    idx = {}
    for i, c in enumerate(cosets):
        for a in c: idx[a] = i
    return cosets, idx

def mk(p, U):
    cosets, idx = build(p, U)
    def hadd(A, B):
        if A is None: return {B}
        if B is None: return {A}
        return {None if (a+b) % p == 0 else idx[(a+b) % p]
                for a in cosets[A] for b in cosets[B]}
    def hsum(ts):
        S = {ts[0]}
        for t in ts[1:]:
            S = set().union(*[hadd(s, t) for s in S])
        return S
    mul = lambda A,B: None if (A is None or B is None) else idx[(next(iter(cosets[A]))*next(iter(cosets[B]))) % p]
    neg = lambda A: None if A is None else idx[(-next(iter(cosets[A]))) % p]
    return cosets, idx, hadd, hsum, mul, neg

def test_all(p, U):
    cosets, idx, hadd, hsum, mul, neg = mk(p, U)
    ONE = idx[1]
    n = len(cosets)
    res = {'step1_ok':0, 's2_pass':0, 's2_fail':0, 's3_pass':0, 's3_fail':0}
    for a, b in itertools.product(range(n), repeat=2):
        if ONE not in hadd(a, b): continue
        ab = mul(a,b); nab = neg(ab)
        a2b, ab2 = mul(mul(a,a),b), mul(a,mul(b,b))
        C3 = lambda t: mul(t, mul(t,t))
        Mset = hsum([a2b,a2b,a2b,ab2,ab2,ab2])
        Gset = hadd(C3(a), C3(b))
        step1 = False
        for g in Gset:
            for m in Mset:
                if None in hsum([g, m, neg(ONE)]):
                    step1 = True
                    # Step 2 test: 0 ∈ m ⊞ g ⊞ (-ab)"'^{⊞3} ?
                    W3 = hsum([nab, nab, nab])
                    if None in hsum([m, g] + [nab,nab,nab]):
                        res['"'s2_pass'] += 1
                    else:
                        res['s2_fail'] += 1
                # (always-on check) final theorem for c=-1 scaled back:
        if step1: res['step1_ok'] += 1
        # Sanity: theorem for (a,b,-1): 0 ∈ a³⊞b³⊞(-1)⊞ab⊞ab⊞ab
        if None not in hsum([C3(a), C3(b), neg(ONE), ab, ab, ab]):
            return f\"THEOREM FAILS a={a} b={b}\"
    return res

for p in [q for q in range(5, 40) if isprime(q)]:
    for d in range(2, p):
        if (p-1) % d: continue
        g = primitive_root(p)
        gen = pow(g, (p-1)//d, p)
        U = sorted(frozenset(pow(gen, k, p) for k in range(d)))
        if len(U) >= p-1: continue
        r = test_all(p, U)
        if isinstance(r, str):
            print(\"FAIL\", p, U, r)
        else:
            if r['s2_fail']:
                print(f\"p={p} |U|={len(U)}: step2 fails {r['s2_fail']} / passes {r['s2_pass']}\")
print(\"step1 (A2 tower) holds; step2 (single-label replacement) status printed above\")
EOF
